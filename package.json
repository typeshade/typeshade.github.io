    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^6.4.8",
    "astro-expressive-code": "^0.44.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
