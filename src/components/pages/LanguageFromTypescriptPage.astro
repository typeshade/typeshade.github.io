---
// Language guide: TypeScript construct by construct. The words live in
// language.mapping.fromTypescript (src/i18n/en.ts, src/i18n/ko.ts); the code in a card's two
// panes is not words at all. Each construct carries a short `"use typeshade"` program that
// src/lib/typescript-lowering.ts compiles with the pinned compiler at build time, the way
// src/lib/concepts-emit.ts compiles the front page's sample, and the card shows the part of
// the emit it is about. A construct the language refuses shows the compiler's own diagnostic
// there. The cards render through ConstructCard.astro, whose header comment documents its
// props and the CSS classes it uses.
import Docs from '../../layouts/Docs.astro'
import ConstructCard from '../ConstructCard.astro'
import Rich from '../Rich.astro'
import { copyFor, type Locale } from '../../i18n/index.ts'
import { editCopy, links } from '../../lib/links.ts'
import { loweringSections } from '../../lib/typescript-lowering.ts'

interface Props { locale: Locale }
const { locale } = Astro.props
const c = copyFor(locale).language.mapping.fromTypescript
const sections = loweringSections()

// A construct with no words about it, or words about a construct that has gone, is a page
// half written. Both stop the build here, where the generator and the dictionary can be put
// back in step.
const ids = sections.flatMap((s) => s.rows.map((r) => r.id))
const missing = ids.filter((id) => !(id in c.rows))
const spare = Object.keys(c.rows).filter((id) => !ids.includes(id))
if (missing.length > 0 || spare.length > 0) {
  const parts = [
    missing.length > 0 ? `no line for ${missing.join(', ')}` : '',
    spare.length > 0 ? `a line for the row(s) ${spare.join(', ')}, which the generator no longer carries` : '',
  ].filter(Boolean)
  throw new Error(`[from-typescript] the dictionary and src/lib/typescript-lowering.ts disagree: ${parts.join('; ')}`)
}

const headings = [
  { depth: 2, slug: 'reading', text: c.readingH },
  ...sections.map((s) => ({ depth: 2, slug: s.key, text: c.sections[s.key].h })),
]
---

<Docs
  locale={locale}
  path={links.languageFromTypescript.href}
  title={c.title}
  description={c.description}
  headings={headings}
  editHref={editCopy(locale, 'language')}
>
  <h1>{c.h1}</h1>
  <p>{c.intro}</p>

  <h2 id="reading">{c.readingH}</h2>
  <p><Rich text={c.readingP} locale={locale} /></p>
  <p><Rich text={c.guidesP} locale={locale} /></p>

  {sections.map((section) => (
    <>
      <h2 id={section.key}>{c.sections[section.key].h}</h2>
      <p><Rich text={c.sections[section.key].p} locale={locale} /></p>
      <ul class="construct-cards">
        {section.rows.map((row) => (
          <ConstructCard
            locale={locale}
            name={c.rows[row.id]!.name}
            becomes={c.rows[row.id]!.p}
            ts={row.ts}
            tsTitle={c.paneTs}
            emitTitle={c.paneWgsl}
            wgsl={row.wgsl}
            diagnostic={row.diagnostic}
            refusedLabel={c.refused}
            diagnosticTitle={c.paneDiagnostic}
          />
        ))}
      </ul>
    </>
  ))}

  <p><Rich text={c.sourceP} locale={locale} /></p>
</Docs>
