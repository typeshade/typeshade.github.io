---
import Docs from '../../layouts/Docs.astro'
import { type Locale } from '../../i18n/index.ts'
import { links } from '../../lib/links.ts'

interface Props { locale: Locale }
const { locale } = Astro.props

const content = locale === 'ko'
  ? {
      title: 'TypeShade 언어 가이드',
      description: '`"use typeshade"` 파일에서 사용하는 TypeShade의 공식 언어 표면을 설명합니다.',
      h1: '`use typeshade` 언어 표면',
      intro: 'TypeShade는 TypeScript의 문법을 다시 발명하지 않습니다. TypeScript 파서가 받아들이는 문법을 기반으로 하되, GPU 프로그램에 필요한 타입·리소스·스테이지 의미론을 정적으로 제한합니다. 제품 코드는 `"use typeshade"`로 시작하는 파일을 사용합니다.',
      boundaryH: '1. 파일 경계',
      boundaryP: '`"use typeshade"`는 일반 TypeScript 파일과 TypeShade 프로그램을 구분하는 언어 경계입니다. 전처리기나 별도의 TypeShade 문법 파일을 만들지 않고 TypeScript 소스 안에서 셰이더를 작성합니다.',
      shapeH: '2. GPU 개념과 TypeShade 문법',
      shapeP: 'GPU 프로그램의 핵심 개념은 세 곳으로 나뉩니다: 호스트가 채우는 리소스, GPU 값의 레이아웃, 그리고 셰이더 스테이지입니다.',
      resourceH: '3. 리소스는 `declare`로 표현합니다',
      resourceP: '리소스는 TypeShade가 소유한 JavaScript 객체가 아니라 호스트가 바인딩할 슬롯입니다. `uniform<T>`는 읽기 전용 uniform, `storage<T>`는 storage 공간을 나타냅니다.',
      typeH: '4. 값 타입은 `type` 또는 `class`로 표현합니다',
      typeP: '필드 메타데이터가 필요하지 않으면 type alias를 사용합니다. `@location`, `@builtin`, `@align`, `@size`, `@offset`, `@interpolate`, `@ignore` 같은 속성이 필요하면 class field에만 decorator를 붙입니다. 여기서 class는 런타임 객체가 아니라 GPU struct입니다.',
      entryH: '5. 엔트리 포인트는 top-level function입니다',
      entryP: '`@vertex`, `@fragment`, `@compute`는 top-level exported function에만 붙습니다. decorator가 없는 function은 helper입니다. class 안에 엔트리 메서드를 만들거나 `this`를 GPU pipeline으로 취급하지 않습니다.',
      exampleH: '6. 전체 예제',
      restrictionsH: '7. TypeScript와 다른 점',
      restrictions: [
        'JavaScript 런타임 객체를 GPU 객체처럼 사용할 수 없습니다.',
        '`new`, class inheritance, 일반 JS Array와 같은 동적 런타임 모델은 GPU IR에 그대로 내려가지 않습니다.',
        'resource는 initializer를 갖지 않고 `declare const` 또는 `declare let`으로 호스트 슬롯을 선언합니다.',
        '`gid`, `vid`, `pid` 같은 stage builtin은 올바른 entry stage 안에서만 사용할 수 있습니다.',
        'TypeScript 문법이 파싱된다는 사실과 GPU 의미론이 허용된다는 사실은 동일하지 않습니다. 컴파일러가 두 단계를 정적으로 검사합니다.',
      ],
      nextH: '다음 학습 순서',
      nextP: '먼저 Quick start에서 실제 파일을 하나 작성한 뒤, 이 페이지에서 언어 경계를 이해하세요. 그 다음 기존 Authoring guide에서 IR, emit, reflection과 진단을 학습하면 됩니다.',
      next: 'Quick start',
    }
  : {
      title: 'TypeShade language guide',
      description: 'The official `"use typeshade"` language surface: resources, value types, entry points and GPU-specific restrictions.',
      h1: 'The `use typeshade` language surface',
      intro: 'TypeShade does not invent a second programming syntax. It builds on syntax the TypeScript parser already accepts, then applies a separate shader type and execution model. Product code uses files that start with `"use typeshade"`.',
      boundaryH: '1. The file boundary',
      boundaryP: '`"use typeshade"` marks a file as a TypeShade program. It is the boundary between ordinary application TypeScript and shader semantics. There is no preprocessor and no separate shader-only source format.',
      shapeH: '2. Three GPU concepts, three language constructs',
      shapeP: 'TypeShade gives the GPU model explicit places in the source: host-owned resources, GPU value layouts, and shader stages.',
      resourceH: '3. Resources use `declare`',
      resourceP: 'A resource is a host-filled binding slot, not a JavaScript object owned by the shader. `uniform<T>` is read-only uniform storage; `storage<T>` is storage space and can be read-only or writable depending on the declaration.',
      typeH: '4. Value types use `type` or `class`',
      typeP: 'Use a type alias for plain data. Use a class when fields need metadata such as `@location`, `@builtin`, `@align`, `@size`, `@offset`, `@interpolate` or `@ignore`. A TypeShade class is a GPU struct, not a runtime object.',
      entryH: '5. Entry points are top-level functions',
      entryP: '`@vertex`, `@fragment` and `@compute` decorate top-level exported functions. An undecorated function is a helper. Entry points do not live on classes and `this` is not a GPU pipeline object.',
      exampleH: '6. A complete example',
      restrictionsH: '7. Where TypeScript stops',
      restrictions: [
        'JavaScript runtime objects cannot be treated as GPU objects.',
        '`new`, class inheritance and dynamic JavaScript arrays do not map directly to the shader IR.',
        'Resources have no initializer; `declare const` and `declare let` describe host-owned slots.',
        'Stage builtins such as `gid`, `vid` and `pid` are only valid in their matching entry stage.',
        'Being valid TypeScript syntax does not automatically make a construct valid shader semantics. TypeShade checks both the syntax boundary and the GPU model statically.',
      ],
      nextH: 'What to learn next',
      nextP: 'Start with Quick start and write one real file. Then use this page as the language reference, and move to the existing Authoring guide for IR, emit, reflection and diagnostics.',
      next: 'Quick start',
    }

const headings = [
  ['boundary', content.boundaryH],
  ['shape', content.shapeH],
  ['resources', content.resourceH],
  ['types', content.typeH],
  ['entries', content.entryH],
  ['example', content.exampleH],
  ['restrictions', content.restrictionsH],
  ['next', content.nextH],
].map(([slug, text]) => ({ depth: 2, slug, text }))
---

<Docs locale={locale} path="/guide/language/" title={content.title} description={content.description} headings={headings}>
  <h1>{content.h1}</h1>
  <p>{content.intro}</p>

  <h2 id="boundary">{content.boundaryH}</h2>
  <p>{content.boundaryP}</p>
  <pre><code>{`"use typeshade"\n`}</code></pre>

  <h2 id="shape">{content.shapeH}</h2>
  <p>{content.shapeP}</p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>{locale === 'ko' ? 'GPU 개념' : 'GPU concept'}</th><th>TypeShade</th><th>{locale === 'ko' ? 'decorator' : 'Decorators'}</th></tr></thead>
      <tbody>
        <tr><td>{locale === 'ko' ? 'Buffer / UBO' : 'Buffer / UBO'}</td><td><code>declare const/let</code> + <code>uniform&lt;T&gt;</code> / <code>storage&lt;T&gt;</code></td><td>없음</td></tr>
        <tr><td>{locale === 'ko' ? '값 레이아웃' : 'Value layout'}</td><td><code>type</code> 또는 <code>class</code> field</td><td>class field에만</td></tr>
        <tr><td>{locale === 'ko' ? 'Shader stage' : 'Shader stage'}</td><td>top-level <code>export function</code></td><td><code>@compute</code> / <code>@vertex</code> / <code>@fragment</code></td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="resources">{content.resourceH}</h2>
  <p>{content.resourceP}</p>
  <pre><code>{`declare const camera: uniform<Camera>\ndeclare const src: storage<f32>\ndeclare let pixels: storage<f32>`}</code></pre>
  <p><code>declare const x: uniform&lt;T&gt;</code>는 읽기 전용이고, <code>declare let x: storage&lt;T&gt;</code>는 읽고 쓸 수 있습니다. <code>uniform</code>은 <code>let</code>으로 선언할 수 없습니다.</p>

  <h2 id="types">{content.typeH}</h2>
  <p>{content.typeP}</p>
  <pre><code>{`type Camera = {\n  view: mat4\n  pos: vec3\n}\n\nclass VsIn {\n  @location(0) position: vec3\n  @location(1) @interpolate("linear") uv: vec2\n}`}</code></pre>

  <h2 id="entries">{content.entryH}</h2>
  <p>{content.entryP}</p>
  <pre><code>{`@compute([64, 1, 1])\nexport function paint() {\n  pixels[gid.x] = pixels[gid.x] + camera.pos.x\n}\n\n@vertex\nexport function vs(vin: VsIn): vec4 {\n  return camera.view * vec4(vin.position, 1)\n}\n\n@fragment\nexport function fs(): vec4 {\n  return vec4(1, 0, 0, 1)\n}`}</code></pre>

  <h2 id="example">{content.exampleH}</h2>
  <pre><code>{`"use typeshade"\n\nclass Camera {\n  @align(16)\n  view: mat4\n  pos: vec3\n}\n\ndeclare const camera: uniform<Camera>\ndeclare let pixels: storage<array<f32>>\n\n@compute([64, 1, 1])\nexport function paint() {\n  const i = gid.x\n  pixels[i] = pixels[i] + camera.pos.x\n}`}</code></pre>

  <h2 id="restrictions">{content.restrictionsH}</h2>
  <ul>{content.restrictions.map((item) => <li>{item}</li>)}</ul>

  <h2 id="next">{content.nextH}</h2>
  <p>{content.nextP} <a href={locale === 'ko' ? '/ko/guide/quick-start/' : links.quickStart.href}>{content.next}</a></p>
</Docs>
