---
// The authoring guide, rendered from the compiler's AUTHORING.md at the pinned commit. The
// body is English on every locale; the note and the chrome follow the page's language.
import { getCollection, render } from 'astro:content'
import Docs from '../../layouts/Docs.astro'
import Rich from '../Rich.astro'
import { copyFor, type Locale } from '../../i18n/index.ts'
import { links } from '../../lib/links.ts'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const g = copyFor(locale).guide
const [entry] = await getCollection('guide')
if (!entry) throw new Error('[guide] vendor/shader-dsl/AUTHORING.md is not in the collection')
const { Content, headings } = await render(entry)
const sections = headings.filter((h) => h.depth === 2)
if (sections.length < 5) throw new Error(`[guide] only ${sections.length} sections; the guide changed shape`)
---

<Docs locale={locale} path={links.guide.href} title={g.title} description={g.description} headings={sections} bodyLang="en">
  <p class="guide-note" lang={locale}><Rich text={g.note} locale={locale} /></p>
  <Content />
</Docs>
