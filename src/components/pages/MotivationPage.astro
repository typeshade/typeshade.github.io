---
import Base from '../../layouts/Base.astro'
import Rich from '../Rich.astro'
import { copyFor, type Locale } from '../../i18n/index.ts'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const m = copyFor(locale).motivation
---

<Base locale={locale} path="/motivation" title={m.title} description={m.description}>
  <article class="wrap doc">
    <h1>{m.h1}</h1>
    {m.paragraphs.map((p) => <p><Rich text={p} locale={locale} /></p>)}
  </article>
</Base>
