---
// The first conceptual page: explain the language boundary before compiler internals.
import Docs from '../../layouts/Docs.astro'
import { type Locale } from '../../i18n/index.ts'
import { links } from '../../lib/links.ts'

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const content = locale === 'ko'
  ? {
      title: 'TypeShade란 무엇인가',
      description: 'TypeScript의 개발 경험을 유지하면서 셰이더 프로그램을 작성하도록 설계된 TypeShade 언어와 `use typeshade`의 의미를 설명합니다.',
      h1: 'TypeScript에서 시작하는 셰이더 언어',
      sections: [
        ['TypeShade는 무엇을 바꾸나요?', 'TypeShade는 TypeScript 코드를 그대로 셰이더로 실행하는 런타임이 아닙니다. TypeScript 파일의 익숙한 문법과 도구 경험을 출발점으로 삼고, GPU 프로그램에 필요한 타입과 의미론을 가진 별도의 컴파일 언어로 해석합니다.'],
        ['`use typeshade`는 언어 경계입니다', '`"use typeshade"`는 TypeShade 프로그램임을 선언하는 파일 수준 지시어입니다. 이 선언이 있는 파일에서는 컴파일러가 TypeShade의 셰이더 의미론을 적용합니다. 따라서 이 한 줄을 이해하는 것이 TypeShade를 이해하는 첫 단계입니다.'],
        ['TypeScript와 무엇이 같은가요?', 'TypeShade가 TypeScript 개발자에게 익숙하게 느껴지는 이유는 함수, 타입 주석, 모듈, 표현식과 제어 흐름 같은 언어 개념을 공유하기 때문입니다. 하지만 이름이 같다고 해서 TypeScript의 모든 기능을 그대로 사용할 수 있다는 뜻은 아닙니다. 지원되는 기능과 셰이더에서 의미가 달라지는 기능은 언어 가이드에서 명시적으로 설명합니다.'],
        ['무엇이 셰이더답게 달라지나요?', 'GPU 실행 모델에는 CPU 프로그램과 다른 제약이 있습니다. 값의 종류, 리소스와 레이아웃, 엔트리 포인트, 타깃별 기능과 출력 규칙이 그 예입니다. TypeShade의 목적은 이런 제약을 문자열을 직접 작성할 때보다 앞 단계에서 드러내는 것입니다.'],
        ['컴파일 결과는 무엇인가요?', 'TypeShade 소스는 중간 표현으로 내려간 뒤 호스트가 사용할 셰이더 소스로 출력됩니다. 현재 WebGPU에는 WGSL을, WebGL2에는 GLSL ES 3.00을 생성합니다. TypeShade 런타임을 브라우저에 배포하는 방식이 아니라 컴파일된 결과를 호스트가 소비하는 방식입니다.'],
        ['어디서부터 배우면 되나요?', '처음이라면 Quick start에서 실제 파일 하나를 만든 다음 Language guide에서 타입, 값과 표현식, 함수, 제어 흐름, 셰이더 의미론을 순서대로 읽는 것을 권합니다. 컴파일러 내부 동작과 검증 방법은 그 다음에 Concepts와 Verification에서 확인할 수 있습니다.'],
      ],
    }
  : {
      title: 'What is TypeShade?',
      description: 'Learn the TypeShade language, the `use typeshade` boundary, and how TypeScript authoring becomes compiled shader code.',
      h1: 'A shader language that starts in TypeScript',
      sections: [
        ['What does TypeShade change?', 'TypeShade is not a runtime that executes ordinary TypeScript on the GPU. It starts from familiar TypeScript syntax and tooling, then interprets the file as a separate shader language with its own types and semantics.'],
        ['`use typeshade` is the language boundary', 'The file-level `"use typeshade"` directive declares a TypeShade program. Once present, the compiler applies TypeShade shader semantics to the file. Understanding this boundary is the first step to understanding the language.'],
        ['What stays familiar from TypeScript?', 'Functions, type annotations, modules, expressions and control flow give TypeShade a familiar authoring surface. That does not mean every TypeScript feature is available unchanged. The language guide calls out supported features and places where shader semantics differ.'],
        ['What makes it a shader language?', 'GPU programs have constraints that ordinary CPU programs do not. Values, resources and layouts, entry points, target capabilities and output rules all matter. TypeShade makes those constraints part of the authoring and diagnostic experience instead of leaving them to generated strings.'],
        ['What does the compiler produce?', 'TypeShade source is lowered to an intermediate representation and then emitted as host-consumable shader source. The current targets are WGSL for WebGPU and GLSL ES 3.00 for WebGL2. There is no TypeShade runtime to ship with the application.'],
        ['Where should you go next?', 'Start with Quick start to build one real file. Then use the Language guide to learn types, values and expressions, functions, control flow and shader semantics. Compiler internals and verification belong later in Concepts and Verification.'],
      ],
    }
const sections = content.sections.map(([h, p]) => ({ h, p, slug: h.toLowerCase().replace(/[^a-z0-9가-힣]+/g, '-').replace(/^-|-$/g, '') }))
const headings = sections.map((s) => ({ depth: 2, slug: s.slug, text: s.h }))
---

<Docs locale={locale} path={links.motivation.href} title={content.title} description={content.description} headings={headings}>
  <h1>{content.h1}</h1>
  {sections.map((s) => (
    <Fragment>
      <h2 id={s.slug}>{s.h}</h2>
      <p>{s.p}</p>
    </Fragment>
  ))}
</Docs>
