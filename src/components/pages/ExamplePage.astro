---
// One example, on a page of its own, laid out the way ShaderToy lays one out: one card split
// in two, the shader running on the left and its text on the right, and nothing else in
// either pane. The right pane carries its own tab bar over one of four texts, the file first
// and then each target the compiler emits from it. The gallery's tiles link here, so a reader
// who clicks an example stays on the site and sees it draw; the file on GitHub is one link in
// the row at the foot of the page.
//
// The card is the front page's own showcase card (.live-card in src/styles/global.css) and
// the tab bar is the Ant tab head the "one file, two targets" section uses, down to
// src/scripts/target-tabs.ts driving it. What a reader is told about the frame, which backend
// drew it or why nothing did, and where the emitted text comes from, is written under the
// card: a pane with a label in it reads as a figure, and this is a result panel.
//
// Everything on it is read at build time by src/lib/example-pages.ts. The emitted text comes
// from examples/__emit-goldens__/ at the pinned commit, which is the compiler's own output,
// so a page costs nothing to show and cannot disagree with the compiler.
import { Code } from 'astro-expressive-code/components'
import Docs from '../../layouts/Docs.astro'
import CodeFrame from '../CodeFrame.astro'
import Rich from '../Rich.astro'
import ShaderCanvas from '../ShaderCanvas.astro'
import type { CanvasText } from '../ShaderCanvas.astro'
import { copyFor, localePath, localeSettings, type Locale } from '../../i18n/index.ts'
import { editCopy, links } from '../../lib/links.ts'
import { checkedBlurbs } from '../../lib/examples.ts'
import { checkedShade } from '../../lib/shade-examples.ts'
import { examplePage, examplePath, exampleSourceHref, noPictureReasons } from '../../lib/example-pages.ts'

interface Props {
  locale: Locale
  id: string
}
const { locale, id } = Astro.props
const t = copyFor(locale)
const e = t.examples
const p = e.page
const example = examplePage(id)

// Every reason NO_STILL_REASONS can hand a page has a sentence in this language. A reason
// added upstream without one would print nothing under an empty frame.
for (const reason of noPictureReasons) {
  if (!p.noPicture[reason]) throw new Error(`[example-page] src/i18n has no sentence for the reason '${reason}'`)
}

// The registry's own English titles are what the gallery shows in every language; the
// `.shade.ts` corpus writes its titles and its lines in each dictionary.
const shadeTitles = checkedShade('title', e.shade.titles)
const shadeBlurbs = checkedShade('description', e.shade.descriptions)
const blurbs = checkedBlurbs(e.blurbs)
const nameOf = (which: string): string => (examplePage(which).corpus === 'shade' ? shadeTitles[which]! : examplePage(which).title)
const blurbOf = (which: string): string => (examplePage(which).corpus === 'shade' ? shadeBlurbs[which]! : blurbs[which]!)

const name = nameOf(id)
const blurb = blurbOf(id)

// A meta description is plain text, so the code marks and links the gallery's own line
// carries come off it first.
const plain = (text: string): string => text.replace(/`([^`]*)`/g, '$1').replace(/\[([^\]]*)\]\(([^)]+)\)/g, '$1')
const META_MIN = 70
const META_MAX = localeSettings[locale].metaDescriptionMax
const HARD_MAX = 160
// The same cut the reference makes: at the end of a sentence, else at a clause, else at a
// word. A short registry line leaves the description under the floor the SEO checks want, so
// the dictionary's own sentence about the page fills it out.
const markEnd = (window: string, marks: readonly string[]): number => {
  let best = -1
  for (const mark of marks) {
    const withSpace = window.lastIndexOf(`${mark} `)
    if (withSpace >= 0) best = Math.max(best, withSpace + mark.length)
    if (window.endsWith(mark)) best = Math.max(best, window.length)
  }
  return best
}
const cutAt = (text: string, limit: number): string | null => {
  const window = text.slice(0, limit)
  const sentenceEnd = markEnd(window, ['.', '!', '?'])
  if (sentenceEnd >= META_MIN) return window.slice(0, sentenceEnd)
  const clauseEnd = markEnd(window, [',', ';', ':'])
  if (clauseEnd >= META_MIN) return `${window.slice(0, clauseEnd - 1)}…`
  return null
}
const truncate = (text: string, max: number): string =>
  text.length <= max ? text : cutAt(text, max) ?? cutAt(text, HARD_MAX) ?? `${text.slice(0, max - 1).replace(/\s+\S*$/, '')}…`

const title = p.title(name)
if (title.length < 45 || title.length > 60) {
  throw new Error(`[example-page] '${id}' has a ${title.length}-character title, outside the 45 to 60 the SEO checks want: ${title}`)
}
const composed = plain(p.description(name, blurb))
const description = truncate(composed.length < META_MIN ? `${composed} ${plain(p.descriptionPad)}` : composed, META_MAX)
if (description.length < META_MIN || description.length > META_MAX) {
  throw new Error(`[example-page] '${id}' has a ${description.length}-character description, outside ${META_MIN} to ${META_MAX}`)
}

const caption: CanvasText = p.canvas(name)
const sourceHref = exampleSourceHref(example.file)
const playgroundHref = `${localePath(locale, links.playground.href)}#example=${example.id}`
const pager = (which: string | undefined) => (which ? { label: nameOf(which), href: localePath(locale, examplePath(which)) } : undefined)
const glsl = example.emitted.glsl

// The tabs, in the order a reader meets them: the file first, then what it becomes. A
// WGSL-only example has the two it has. The source tab is named by its file, which is not
// copy and reads the same in every language, the way every code frame on the site names its
// file; the emitted tabs are named by their target.
const panes = [
  { key: 'source', label: example.file, region: `${p.source}, ${example.file}`, code: example.source, lang: 'ts' },
  { key: 'wgsl', label: p.wgsl, region: p.wgsl, code: example.emitted.wgsl, lang: 'wgsl' },
  ...(glsl
    ? [
        { key: 'vertex', label: p.glslVertex, region: p.glslVertex, code: glsl.vertex, lang: 'glsl' },
        { key: 'fragment', label: p.glslFragment, region: p.glslFragment, code: glsl.fragment, lang: 'glsl' },
      ]
    : []),
]
const paneId = (key: string): string => `example-pane-${key}`
---

<Docs
  locale={locale}
  path={examplePath(id)}
  title={title}
  description={description}
  editHref={editCopy(locale, 'examples')}
  label={name}
  previous={pager(example.previous)}
  next={pager(example.next)}
>
  <h1>{name}</h1>
  <p><Rich text={blurb} locale={locale} /></p>

  <div class="example-stage" data-front-tabs data-shader-scope>
    <div class="live-card">
      <div class="example-stage-body">
        <div class="example-stage-view">
          {example.drawn ? (
            <ShaderCanvas locale={locale} example={example.id} aspect="auto" caption={caption} eager externalCaption />
          ) : (
            <div class="figure-frame">
              <span class="example-tile-blank">
                <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                  <rect x="3.75" y="8.75" width="32.5" height="22.5" rx="3" />
                  <path d="M3.75 24.5l7.5-6.5 6 5 5.5-4.5 13.5 11" />
                  <circle cx="14.5" cy="15.5" r="2.25" />
                </svg>
              </span>
            </div>
          )}
        </div>

        <div class="example-stage-code">
          <div class="front-tabs-head" role="tablist" aria-label={p.tabs}>
            {panes.map((pane, i) => (
              <button
                type="button"
                role="tab"
                id={`${paneId(pane.key)}-tab`}
                aria-controls={paneId(pane.key)}
                aria-selected={i === 0 ? 'true' : 'false'}
              >{pane.label}</button>
            ))}
          </div>
          {/* The tab already names the pane, so the frame inside it carries no title bar of
              its own; the label stays as the code region's accessible name. The source pane
              opens on the line the shader starts at (src/scripts/example-stage.ts). */}
          <div class="example-stage-panels" data-example-panels>
            {panes.map((pane) => (
              <div
                class="front-tabs-panel"
                role="tabpanel"
                id={paneId(pane.key)}
                aria-labelledby={`${paneId(pane.key)}-tab`}
                data-entry-line={pane.key === 'source' ? String(example.entryLine) : undefined}
              >
                <CodeFrame label={pane.region}><Code code={pane.code} lang={pane.lang} locale={locale} wrap /></CodeFrame>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="example-stage-notes">
      <p>{example.drawn ? <span data-shader-caption>{caption.neutral}</span> : p.noPicture[example.reason!]}</p>
      <p><Rich text={p.emittedNote} locale={locale} /></p>
    </div>
  </div>

  <p class="example-page-links">
    <a href={sourceHref}>{p.github}</a>
    {example.inPlayground && <a href={playgroundHref}>{p.playground}</a>}
  </p>
</Docs>

<script>
  // The tabs over the source and the emitted targets, shared with the front page's own
  // section, and then the code pane opened on the line the shader starts at. The order
  // matters: the pane has to be the selected one before it can be measured.
  import '../../scripts/target-tabs.ts'
  import '../../scripts/example-stage.ts'
</script>
