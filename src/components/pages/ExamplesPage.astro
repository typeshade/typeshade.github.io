---
import { Code } from 'astro-expressive-code/components'
import Docs from '../../layouts/Docs.astro'
import CodeFrame from '../CodeFrame.astro'
import Rich from '../Rich.astro'
import ShaderCanvas from '../ShaderCanvas.astro'
import type { CanvasText } from '../ShaderCanvas.astro'
import { copyFor, localePath, type Locale } from '../../i18n/index.ts'
import { editCopy, links } from '../../lib/links.ts'
import { checkedBlurbs, facts, hero } from '../../lib/examples.ts'
import { checkedShade, shadeExampleList, SHADE_GROUPS } from '../../lib/shade-examples.ts'
import { examples } from '../../../vendor/shader-dsl/examples/index.ts'
import { SHADE_STILL_EXAMPLES, STILL_EXAMPLES } from '../../../scripts/artifacts.mjs'
import { slugify } from '../../lib/slug.ts'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = copyFor(locale)
const e = t.examples

const deepZoom: CanvasText = {
  neutral: e.f64.caption,
  webgpu: e.f64.caption,
  webgl2: e.f64.caption,
  none: `${e.f64.caption} ${e.f64.captionNone}`,
}
const order = ['cartographic', 'generic', 'compute'] as const
const headings = [
  ...order.map((c) => ({ depth: 2, slug: slugify(c), text: e.categories[c] })),
  { depth: 2, slug: slugify(e.shade.h), text: e.shade.h },
  ...SHADE_GROUPS.map((g) => ({ depth: 3, slug: slugify(g.key), text: e.shade.groups[g.key] })),
  ...[e.glsl.h, e.f64.h].map((h) => ({ depth: 2, slug: slugify(h), text: h })),
]

const learningPath = e.path.steps.map((step) => ({ ...step, href: localePath(locale, links[step.linkKey].href) }))

const blurbs = checkedBlurbs(e.blurbs)
const stills = new Set<string>(STILL_EXAMPLES)
const rows = examples.map((x) => ({
  id: x.id,
  still: stills.has(x.id),
  title: x.title,
  href: `${facts.mirrorUrl}/blob/${facts.pinnedCommit}/examples/${x.file}`,
  category: e.categories[x.category],
  wgslOnly: x.id === facts.wgslOnlyExample.id,
  blurb: blurbs[x.id]!,
}))
const groups = order.map((c) => rows.filter((r) => r.category === e.categories[c]))

// The other corpus. Same tile, same still rule; the picture is there for the ones the page
// can draw and the plain mark stands in for the rest.
const shadeTitleFor = checkedShade('title', e.shade.titles)
const shadeTextFor = checkedShade('description', e.shade.descriptions)
const shadeStills = new Set<string>(SHADE_STILL_EXAMPLES)
const shadeById = new Map(shadeExampleList.map((x) => [x.id, x]))
const shadeGroups = SHADE_GROUPS.map((g) => ({
  key: g.key,
  heading: e.shade.groups[g.key],
  rows: g.ids.map((id) => {
    const x = shadeById.get(id)!
    return {
      id,
      still: shadeStills.has(id),
      title: shadeTitleFor[id]!,
      href: `${facts.mirrorUrl}/blob/${facts.pinnedCommit}/examples/${x.file}`,
      wgslOnly: !x.renderable,
      blurb: shadeTextFor[id]!,
    }
  }),
}))
const printCommands = ['npx tsx examples/print.ts', 'npx tsx examples/print.ts hillshade'].join('\n')
---

<Docs locale={locale} path={links.examples.href} title={e.title} description={e.description} headings={headings} editHref={editCopy(locale, 'examples')}>
    <h1>{e.h1}</h1>
    <p><Rich text={e.intro} locale={locale} /></p>

    <section class="learning-path">
      <h2>{e.path.h}</h2>
      <p>{e.path.p}</p>
      <ol>
        {learningPath.map((step) => (
          <li>
            <strong>{step.title}</strong>
            <p>{step.text}</p>
            <a href={step.href}>{step.label} →</a>
          </li>
        ))}
      </ol>
    </section>

    <p class="example-table-caption">{e.tableCaption}</p>
    {groups.map((group, i) => (
      <section class="example-group">
        <h2 id={slugify(order[i]!)}>{e.categories[order[i]!]}</h2>
        <ul class="example-grid">
          {group.map((row) => (
            <li>
              <a class="example-tile" href={row.href}>
                <span class="example-tile-frame">
                  {row.still ? <img src={`/stills/${row.id}.webp`} alt="" loading="lazy" decoding="async" /> : (
                    <span class="example-tile-blank">
                      <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                        <rect x="3.75" y="8.75" width="32.5" height="22.5" rx="3" />
                        <path d="M3.75 24.5l7.5-6.5 6 5 5.5-4.5 13.5 11" />
                        <circle cx="14.5" cy="15.5" r="2.25" />
                      </svg>
                      <span class="example-tile-blank-note">{e.noStill}</span>
                    </span>
                  )}
                </span>
                <span class="example-tile-title">{row.title}{row.wgslOnly && <span class="example-wgsl-only">{e.wgslOnly}</span>}</span>
                <span class="example-tile-blurb"><Rich text={row.blurb} locale={locale} /></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="example-group">
      <h2 id={slugify(e.shade.h)}>{e.shade.h}</h2>
      <p><Rich text={e.shade.p} locale={locale} /></p>
      {shadeGroups.map((group) => (
        <Fragment>
          <h3 id={slugify(group.key)}>{group.heading}</h3>
          <ul class="example-grid">
            {group.rows.map((row) => (
              <li>
                <a class="example-tile" href={row.href}>
                  <span class="example-tile-frame">
                    {row.still ? <img src={`/stills/${row.id}.webp`} alt="" loading="lazy" decoding="async" /> : (
                      <span class="example-tile-blank">
                        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                          <rect x="3.75" y="8.75" width="32.5" height="22.5" rx="3" />
                          <path d="M3.75 24.5l7.5-6.5 6 5 5.5-4.5 13.5 11" />
                          <circle cx="14.5" cy="15.5" r="2.25" />
                        </svg>
                        <span class="example-tile-blank-note">{e.noStill}</span>
                      </span>
                    )}
                  </span>
                  <span class="example-tile-title">{row.title}{row.wgslOnly && <span class="example-wgsl-only">{e.wgslOnly}</span>}</span>
                  <span class="example-tile-blurb"><Rich text={row.blurb} locale={locale} /></span>
                </a>
              </li>
            ))}
          </ul>
        </Fragment>
      ))}
    </section>

    <p>{e.printIntro}</p>
    <CodeFrame label={t.codeLabels.print}><Code code={printCommands} lang="bash" locale={locale} /></CodeFrame>
    <section><h2 id={slugify(e.glsl.h)}>{e.glsl.h}</h2><p><Rich text={e.glsl.p1} locale={locale} /></p><CodeFrame label={t.codeLabels.glsl}><Code code={hero.glsl} lang="glsl" locale={locale} /></CodeFrame><p><Rich text={e.glsl.p2} locale={locale} /></p></section>
    <section><h2 id={slugify(e.f64.h)}>{e.f64.h}</h2><p><Rich text={e.f64.p1} locale={locale} /></p><p><Rich text={e.f64.p2} locale={locale} /></p><ShaderCanvas locale={locale} example="fp64-deep-zoom" aspect="3/1" still split caption={deepZoom} /></section>
</Docs>
