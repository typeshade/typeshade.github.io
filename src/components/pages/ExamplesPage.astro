---
import { Code } from 'astro-expressive-code/components'
import Docs from '../../layouts/Docs.astro'
import CodeFrame from '../CodeFrame.astro'
import Rich from '../Rich.astro'
import ShaderCanvas from '../ShaderCanvas.astro'
import type { CanvasText } from '../ShaderCanvas.astro'
import { copyFor, type Locale } from '../../i18n/index.ts'
import { editCopy, links } from '../../lib/links.ts'
import { checkedBlurbs, facts, hero } from '../../lib/examples.ts'
import { examples } from '../../../vendor/shader-dsl/examples/index.ts'
import { slugify } from '../../lib/slug.ts'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = copyFor(locale)
const e = t.examples

const deepZoom: CanvasText = {
  neutral: e.f64.caption,
  webgpu: e.f64.caption,
  webgl2: e.f64.caption,
  none: `${e.f64.caption} ${e.f64.captionNone}`,
}
const headings = [e.glsl.h, e.f64.h].map((h) => ({ depth: 2, slug: slugify(h), text: h }))

// The gallery: every example in the registry, in its order, grouped by category. A title
// links to the file at the pinned commit, the targets column reads the same GLSL emission
// the count on this page is measured from, and the description comes from the dictionary,
// so the column is in the reader's language like the rest of the page.
const order = ['cartographic', 'generic', 'compute'] as const
const blurbs = checkedBlurbs(e.blurbs)
const rows = examples.map((x) => ({
  title: x.title,
  href: `${facts.mirrorUrl}/blob/${facts.pinnedCommit}/examples/${x.file}`,
  category: e.categories[x.category],
  wgslOnly: x.id === facts.wgslOnlyExample.id,
  blurb: blurbs[x.id]!,
}))
const groups = order.map((c) => rows.filter((r) => r.category === e.categories[c]))
const printCommands = ['npx tsx examples/print.ts', 'npx tsx examples/print.ts hillshade'].join('\n')
---

<Docs locale={locale} path={links.examples.href} title={e.title} description={e.description} headings={headings} editHref={editCopy(locale, 'examples')}>
    <h1>{e.h1}</h1>
    <p><Rich text={e.intro} locale={locale} /></p>
    <p class="example-table-caption">{e.tableCaption}</p>

    <table class="example-table" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">{e.columns.example}</th>
          <th role="columnheader" scope="col">{e.columns.category}</th>
          <th role="columnheader" scope="col">{e.columns.blurb}</th>
        </tr>
      </thead>
      {groups.map((group) => (
        <tbody role="rowgroup">
          {group.map((row) => (
            <tr role="row">
              <th role="rowheader" scope="row">
                <a href={row.href}>{row.title}</a>
                {row.wgslOnly && <span class="example-wgsl-only">{e.wgslOnly}</span>}
              </th>
              <td role="cell">{row.category}</td>
              <td role="cell"><Rich text={row.blurb} locale={locale} /></td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>

    <p>{e.printIntro}</p>
    <CodeFrame label={t.codeLabels.print}>
      <Code code={printCommands} lang="bash" locale={locale} />
    </CodeFrame>

    <section>
      <h2 id={slugify(e.glsl.h)}>{e.glsl.h}</h2>
      <p><Rich text={e.glsl.p1} locale={locale} /></p>
      <CodeFrame label={t.codeLabels.glsl}>
        <Code code={hero.glsl} lang="glsl" locale={locale} />
      </CodeFrame>
      <p><Rich text={e.glsl.p2} locale={locale} /></p>
    </section>

    <section>
      <h2 id={slugify(e.f64.h)}>{e.f64.h}</h2>
      <p><Rich text={e.f64.p1} locale={locale} /></p>
      <p><Rich text={e.f64.p2} locale={locale} /></p>
      <ShaderCanvas locale={locale} example="fp64-deep-zoom" aspect="3/1" still split caption={deepZoom} />
    </section>
</Docs>
