---
// The design rules' front door, at /reference/rules/: every rule of the compiler's design
// document, under the chapter that holds it, each with its first sentence and a badge that
// says how it is verified. The rules and their lines are the compiler's (src/lib/design-rules.ts,
// rendered by src/lib/rules-loader.ts); the headings and the sentences around them are
// docs.rules in every dictionary.
import { getCollection } from 'astro:content';
import Docs, { type Heading } from '../../layouts/Docs.astro';
import Rich from '../Rich.astro';
import { copyFor, localePath, type Locale } from '../../i18n/index.ts';
import { editCopy, links } from '../../lib/links.ts';
import { facts } from '../../lib/examples.ts';
import { VERIFICATIONS, assertRuleChapters, assertRuleReadings, designRules, ruleChapters, type DesignRule } from '../../lib/design-rules.ts';
import type { RuleHtml } from '../../lib/rules-loader.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = copyFor(locale).docs;
const r = d.reference;
const x = d.rules;
const en = copyFor('en').docs;
assertRuleChapters(en.rules.chapters, x.chapters);
assertRuleReadings(Object.keys(en.errors.lines));

const stored = new Map((await getCollection('rules')).map((s) => [s.id, (s.data as { html: RuleHtml }).html]));
// A row's line is Markdown rendered once, so its links name the English pages.
const localize = (html: string): string =>
  locale === 'en' ? html : html.replace(/href="\/(api|reference\/errors|reference\/rules)\//g, `href="/${locale}/$1/`);
const line = (rule: DesignRule): string => localize(stored.get(rule.slug)?.line ?? '');
const page = (rule: DesignRule): string => localePath(locale, `/reference/rules/${rule.slug}/`);

const chapters = ruleChapters();
const id = (n: number): string => `chapter-${n}`;
const headings: Heading[] = chapters.map((c) => ({ depth: 2, slug: id(c.chapter), text: x.chapterH(c.chapter, x.chapters[c.chapter]!) }));
const first = designRules()[0];
const next = first ? { label: x.entry.heading(first.number), href: page(first) } : undefined;
---

<Docs
  locale={locale}
  path={links.rules.href}
  title={x.title}
  description={x.description}
  headings={headings}
  editHref={editCopy(locale, 'docs')}
  next={next}
  breadcrumbs={[
    { name: r.reference, href: links.reference.href },
    { name: x.h1, href: links.rules.href },
  ]}
  dateModified={facts.pinnedDate}
>
  <nav class="api-crumbs" aria-label={r.breadcrumbs} lang={locale}>
    <a href={localePath(locale, links.reference.href)}>{r.h1}</a>
  </nav>
  <h1 lang={locale}>{x.h1}</h1>
  <p class="api-kind" lang={locale}>{x.rulesCount(facts.rules)}</p>
  <p class="api-summary" lang={locale}><Rich text={x.intro} locale={locale} /></p>
  <p lang={locale}>{x.verifiedP}</p>
  <ul class="rule-kinds" lang={locale}>
    {VERIFICATIONS.map((v) => (
      <li><span class="api-optional">{x.kinds[v]}</span> <Rich text={x.kindCounts[v]} locale={locale} /></li>
    ))}
  </ul>
  <p class="guide-note" lang={locale}><Rich text={x.note} locale={locale} /></p>

  {chapters.map((c) => (
    <>
      <h2 id={id(c.chapter)} lang={locale}>{x.chapterH(c.chapter, x.chapters[c.chapter]!)}</h2>
      <dl class="api-list api-index">
        {c.rules.map((rule) => (
          <>
            <dt>
              <a href={page(rule)} lang={locale}>{x.entry.heading(rule.number)}</a>
              <span class="api-optional" lang={locale}>{x.kinds[rule.verification]}</span>
            </dt>
            <dd lang="en"><Fragment set:html={line(rule)} /></dd>
          </>
        ))}
      </dl>
    </>
  ))}
</Docs>

<style>
  /* The four ways a rule is verified, one per row, each led by the badge its rows carry. The
     list sits in the document column, so its margin outranks `.doc ul`. */
  .rule-kinds { margin-block-start: 8px; padding-inline-start: 0; list-style: none }
  .rule-kinds li { margin-block-start: 6px }
</style>
