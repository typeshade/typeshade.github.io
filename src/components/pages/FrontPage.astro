---
import { Code } from 'astro-expressive-code/components'
import Base from '../../layouts/Base.astro'
import CodeFrame from '../CodeFrame.astro'
import Rich from '../Rich.astro'
import ShaderCanvas from '../ShaderCanvas.astro'
import { copyFor, localePath, type Locale } from '../../i18n/index.ts'
import { useTypeshadeHero } from '../../lib/use-typeshade-emit.ts'
import { useTypeshadeSample } from '../../lib/use-typeshade-sample.ts'
import { links } from '../../lib/links.ts'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = copyFor(locale)
const useLabel = t.codeLabels.useTypeshade ?? 'hello.shade.ts'
const content = t.front.use
---

<Base locale={locale} path="/" searchable searchTitle={content.title}>
  <section class="hero">
    <p class="hero-eyebrow">{content.eyebrow}</p>
    <h1 class="hero-title"><span class="hero-line accent">{content.title}</span></h1>
    <p class="hero-subtitle"><Rich text={content.subtitle} locale={locale} /></p>
    <p class="hero-tagline">{content.tagline}</p>
    <p class="hero-actions">
      <a class="button button-primary" href={localePath(locale, links.quickStart.href)}>
        {content.getStarted}
        <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 2.847 2.828 2.847 2.828 10.975-11z" /></svg>
      </a>
      <a class="button" href={localePath(locale, links.playground.href)}>{content.playground}</a>
      <a class="button" href={localePath(locale, links.motivation.href)}>{content.learn}</a>
      <a class="button" href={localePath(locale, links.guide.href)}>{content.language}</a>
      <a class="button" href={localePath(locale, links.examples.href)}>{content.examples}</a>
    </p>
  </section>

  <section class="wide demo">
    <ShaderCanvas locale={locale} example="metaballs" aspect="3/1" eager caption={t.front.metaballs} />
  </section>

  <section class="wide front-code">
    <h2>{content.flowH}</h2>
    <p><Rich text={content.flowP} locale={locale} /></p>
    <div class="authoring-flow" aria-label={content.flowAriaLabel}>
      <span>{content.flowLabels[0]}</span>
      <span aria-hidden="true">→</span>
      <code>"use typeshade"</code>
      <span aria-hidden="true">→</span>
      <span>{content.flowLabels[1]}</span>
      <span aria-hidden="true">→</span>
      <span>{content.flowLabels[2]}</span>
      <span aria-hidden="true">→</span>
      <span>{content.flowLabels[3]}</span>
    </div>
    <div class="code-pair">
      {/* Code receives only props supported by astro-expressive-code. */}
      <CodeFrame label={useLabel}>
        <Code code={useTypeshadeSample} lang="ts" title="hello.shade.ts" wrap />
      </CodeFrame>
      <CodeFrame label={t.codeLabels.wgsl}>
        <Code code={useTypeshadeHero.wgsl} lang="wgsl" title="WGSL" wrap />
      </CodeFrame>
    </div>
  </section>

  <section class="wide concepts">
    <h2>{content.conceptsH}</h2>
    <p><Rich text={content.conceptsP} locale={locale} /></p>
    <div class="concept-grid">
      {content.concepts.map(([heading, mapping, body]) => (
        <article class="concept">
          <p class="concept-heading">{heading}</p>
          <h3><Rich text={mapping} locale={locale} /></h3>
          <p><Rich text={body} locale={locale} /></p>
        </article>
      ))}
    </div>
  </section>

  <section class="wide highlights">
    {content.highlights.map(([heading, body]) => (
      <div class="highlight">
        <h2><Rich text={heading} locale={locale} /></h2>
        <p><Rich text={body} locale={locale} /></p>
      </div>
    ))}
  </section>
</Base>