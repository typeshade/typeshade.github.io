---
// The front page in one locale: the headline and its three links, the live shader, three
// short points, then Quick start and Status in the document column. Every number is read
// at build time from the compiler vendored at vendor/shader-dsl; the words come from src/i18n.
import { Code } from 'astro-expressive-code/components'
import Base from '../../layouts/Base.astro'
import CodeFrame from '../CodeFrame.astro'
import InstallCommand from '../InstallCommand.astro'
import Rich from '../Rich.astro'
import ShaderCanvas from '../ShaderCanvas.astro'
import { copyFor, localePath, type Locale } from '../../i18n/index.ts'
import { hero } from '../../lib/examples.ts'
import { links } from '../../lib/links.ts'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = copyFor(locale)
const f = t.front
const h = f.hero
---

<Base locale={locale} path="/">
  <section class="hero">
    <h1 class="hero-title">
      {h.before}{h.before && <br />}<span class="accent">{h.accent}</span>{h.after && <br />}{h.after}
    </h1>
    <p class="hero-tagline">{h.tagline}</p>
    <p class="hero-actions">
      <a class="button" href="#quick-start">
        {h.getStarted}
        <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.025 1l-2.847 2.828 6.176 6.176h-16.354v3.992h16.354l-6.176 6.176 2.847 2.828 10.975-11z" /></svg>
      </a>
      <a class="button" href={localePath(locale, links.motivation.href)}>{h.why}</a>
      <a class="button" href={localePath(locale, links.examples.href)}>{h.examples}</a>
    </p>
  </section>

  <section class="wide demo">
    <ShaderCanvas locale={locale} example="metaballs" aspect="3/1" eager caption={f.metaballs} />
  </section>

  <section class="wide highlights">
    {f.highlights.map((item) => (
      <div class="highlight">
        <h2>{item.h}</h2>
        <p><Rich text={item.p} locale={locale} /></p>
      </div>
    ))}
  </section>

  <article class="wrap doc front-doc">
    <div id="quick-start">
      <h2>{f.quickStart.h}</h2>
      <InstallCommand locale={locale} />
      <p><Rich text={f.quickStart.p1} locale={locale} /></p>
      <CodeFrame label={t.codeLabels.authored}>
        <Code code={hero.authored} lang="ts" title={hero.file} />
      </CodeFrame>
      <p>{f.quickStart.p2}</p>
      <CodeFrame label={t.codeLabels.wgsl}>
        <Code code={hero.wgsl} lang="wgsl" />
      </CodeFrame>
      <p><Rich text={f.quickStart.p3} locale={locale} /></p>
    </div>

    <section>
      <h2>{f.status.h}</h2>
      <p><Rich text={f.status.p} locale={locale} /></p>
    </section>
  </article>
</Base>
