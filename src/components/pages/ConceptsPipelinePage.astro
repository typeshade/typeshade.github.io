---
// Concepts: the pipeline, at /guide/concepts/the-pipeline/. What each stage is handed and
// what it produces, and how an entry point signature maps onto that. Copy lives in
// `concepts.pipeline` (src/i18n/en.ts, src/i18n/ko.ts); the code samples are not copy, so
// they stay here.
import Docs from '../../layouts/Docs.astro';
import ConceptDoc from '../ConceptDoc.astro';
import Rich from '../Rich.astro';
import TypeShadeCode from '../TypeShadeCode.astro';
import { copyFor, type Locale } from '../../i18n/index.ts';
import { editCopy, links } from '../../lib/links.ts';
import { slugify } from '../../lib/slug.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copyFor(locale).concepts.pipeline;
const headings = [c.stagesH, c.entryH, c.interpolationH, c.computeH, c.furtherH].map((h) => ({ depth: 2, slug: slugify(h), text: h }));
---

<Docs locale={locale} path={links.conceptsPipeline.href} title={c.title} description={c.description} headings={headings} editHref={editCopy(locale, 'concepts')}>
  <h1>{c.h1}</h1>
  <p>{c.lead}</p>

  <section>
    <h2 id={slugify(c.stagesH)}>{c.stagesH}</h2>
    <p>{c.stagesP}</p>
    <ConceptDoc locale={locale} rows={c.stagesRows} columns={c.stagesColumns} strongTerm />
  </section>

  <section>
    <h2 id={slugify(c.entryH)}>{c.entryH}</h2>
    <p><Rich text={c.entryP} locale={locale} /></p>
    <TypeShadeCode code={`class VsIn {\n  @location(0) position: vec3\n  @location(1) uv: vec2\n}\n\n@vertex\nexport function vs(@builtin("vertex_index") vid: u32, vin: VsIn): vec4 {\n  return camera.view * vec4(vin.position, 1)\n}\n\n@fragment\nexport function fs(@builtin("position") pid: vec4): vec4 {\n  return vec4(pid.x, 0, 0, 1)\n}`} />
    <p>{c.entryNote}</p>
  </section>

  <section>
    <h2 id={slugify(c.interpolationH)}>{c.interpolationH}</h2>
    <p>{c.interpolationP}</p>
    <TypeShadeCode code={`class VsOut {\n  @builtin("position") pos: vec4\n  @location(0) uv: vec2\n  @location(1) id: u32\n  @location(2) @interpolate("flat") tint: vec3\n}`} />
    <p><Rich text={c.interpolationNote} locale={locale} /></p>
  </section>

  <section>
    <h2 id={slugify(c.computeH)}>{c.computeH}</h2>
    <p><Rich text={c.computeP} locale={locale} /></p>
    <TypeShadeCode code={`declare const pixels: storage<array<f32>, "read_write">\n\n@compute([64, 1, 1])\nexport function paint(@builtin("global_invocation_id") gid: vec3u) {\n  pixels[gid.x] = camera.pos.x\n}`} />
  </section>

  <section>
    <h2 id={slugify(c.furtherH)}>{c.furtherH}</h2>
    <ul>{c.furtherItems.map((item) => <li><Rich text={item} locale={locale} /></li>)}</ul>
    <p><Rich text={c.nextP} locale={locale} /></p>
  </section>
</Docs>
