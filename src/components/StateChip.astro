---
// STATE CHIP — design §5. A `<span>`, `cursor: default`, NOT focusable and not in the tab
// order: it is state, not a control (P9, I-10). Used by `NAV.CHIP`, `B5.CHIPS` and `B4.BADGE`.
//
// Where the chip carries a measured number, the numeral is passed separately so it can be set
// in accent mono while the unit and the label stay neutral — the colour is never the carrier.
interface Props {
  /** The measured numeral, if this chip has one. */
  value?: string
  /** The rest of the chip: the unit and the label, adjacent, so the strip linearises. */
  text: string
}
const { value, text } = Astro.props
---

<span class="state-chip">
  {value && <span class="num">{value}</span>}
  {value ? <span>&nbsp;{text}</span> : text}
</span>
