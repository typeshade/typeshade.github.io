---
import ShaderCanvas from './ShaderCanvas.astro'
import { claims } from '../lib/claims.ts'
import { facts } from '../lib/examples.ts'
import { heroCaption, heroCopy } from '../lib/hero-copy.ts'
import { links } from '../lib/links.ts'
---

<section class="wrap hero">
  <div>
    <h1>{heroCopy.h1}</h1>
    <p class="lead mt-5">{heroCopy.sub}</p>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a class="btn" href={links.guide.href}>{links.guide.label}</a>
      <a class="btn-ghost" href={links.mirror.href}>{links.mirror.label}</a>
    </div>
    {
      facts.published === false && (
        <p class="meta mt-5">
          Version {facts.nextVersion} is not on npm yet. The compiler already runs in production inside the X-GIS
          globe engine.
        </p>
      )
    }
  </div>
  <ShaderCanvas example="metaballs" aspect="16/10" caption={heroCaption} />
</section>

<section class="wrap pb-12 lg:pb-16">
  <p class="prose text-text-2">
    Measured from the compiler at commit <a href={links.commit.href}>{links.commit.label}</a> when this page was
    built:{' '}
    {claims.map((c, i) => (
      <>
        {c.text}{' '}<a href={c.source.href}>{c.source.label}</a>{i < claims.length - 1 ? '. ' : '.'}
      </>
    ))}
  </p>
</section>
