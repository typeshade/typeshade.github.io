---
// Expressive Code puts the horizontal scroller on its own <pre>, so the region attributes go
// there, added at build time to the rendered string.
interface Props {
  /** Names the content, for example "Authored fragment, gradient-pass.ts". */
  label: string
}
const { label } = Astro.props

const escape = (s: string): string => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;')

const rendered = await Astro.slots.render('default')
if (!rendered.includes('<pre')) throw new Error(`[CodeFrame] '${label}' rendered no <pre>`)
const html = rendered.replace('<pre', `<pre tabindex="0" role="region" aria-label="${escape(label)}"`)
---

<Fragment set:html={html} />
