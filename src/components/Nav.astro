---
import { facts } from '../lib/examples.ts'
import { MARK } from '../lib/mark.ts'
import { links } from '../lib/links.ts'
---

<header class="nav">
  <div class="flex items-center gap-3">
    <a class="nav-wordmark" href="/">
      <svg class="nav-mark" viewBox={MARK.viewBox} aria-hidden="true" focusable="false">
        <path
          d={MARK.d}
          fill="none"
          stroke="currentColor"
          stroke-width={MARK.strokeWidth}
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      TypeShade
    </a>
    {facts.published === false && <span class="tag">pre-release</span>}
  </div>
  <nav aria-label="Primary">
    <a href={links.docs.href}>{links.docs.label}</a>
    <a href={links.mirror.href}>{links.mirror.label}</a>
  </nav>
</header>
