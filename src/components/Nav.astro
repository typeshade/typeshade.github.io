---
// NAV — design §5 "Nav", copy 07-copy-deck.md §3.
//
// Two links at every width: no hamburger and no `Guide` (IA X10 — `Guide` would be a second
// wording for the destination `Get started` already owns). The chip is a <span>: state, not a
// control, and it is not in the tab order (P9, I-10). The mark is the favicon's one path
// inline at 20 x 20 with `stroke: currentColor`, so it inherits the text tier and needs no
// forced-colors rule of its own (§9). The path itself comes from `mark.ts`, which
// `scripts/build-icons.ts` asserts against `public/favicon.svg` — the ONE source.
import { facts } from '../lib/examples.ts'
import { MARK } from '../lib/mark.ts'
import { links } from '../lib/links.ts'
---

<header class="nav" data-nav>
  <div class="flex items-center gap-2">
    <a class="nav-wordmark" href="/">
      <svg class="nav-mark" viewBox={MARK.viewBox} aria-hidden="true" focusable="false">
        <path
          d={MARK.d}
          fill="none"
          stroke="currentColor"
          stroke-width={MARK.strokeWidth}
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      TypeShade
    </a>
    {facts.published === false && <span class="state-chip">pre-release</span>}
  </div>
  <nav aria-label="Primary" data-nav-links>
    <a href={links.docs.href}>{links.docs.label}</a>
    <a href={links.mirror.href}>{links.mirror.label}</a>
  </nav>
</header>

<script>
  // I-7 / §6: ONE 1 px sentinel at the hero's lower edge drives ONE IntersectionObserver.
  // No scroll listener, and it never hides on scroll-down — hiding costs the visitor a
  // gesture at the moment they decided to act.
  //
  // A page with no hero (/404) has no sentinel: the nav is then never over a canvas, so it
  // takes the condensed ground immediately rather than sitting transparent on flat ground.
  const nav = document.querySelector<HTMLElement>('[data-nav]')
  const sentinel = document.querySelector('[data-nav-sentinel]')
  if (nav) {
    if (!sentinel) nav.dataset.condensed = ''
    else {
      new IntersectionObserver(
        ([entry]) => {
          if (!entry) return
          if (entry.isIntersecting) delete nav.dataset.condensed
          else nav.dataset.condensed = ''
        },
        { threshold: 0 },
      ).observe(sentinel)
    }
  }
</script>
