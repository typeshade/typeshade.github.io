---
import { facts } from '../lib/examples.ts'
import { links } from '../lib/links.ts'

const items = [links.guide, links.docs, links.mirror, links.npm, links.llms]
---

<footer class="footer">
  <div class="wrap">
    <ul class="flex flex-wrap gap-x-6 gap-y-2 list-none p-0 m-0">
      {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
    <p class="mt-6">
      TypeShade is {facts.license} licensed. This page was built from the compiler at commit{' '}
      <a href={links.commit.href}>{links.commit.label}</a>.
    </p>
  </div>
</footer>
