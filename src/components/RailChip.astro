---
// RAIL.CHIP — design §5 "Rail chip", IA §4.3 `RAIL.CHIP` 1–5.
//
// One claim sentence carrying its number-or-name AND its condition, then a linked route.
// The chip is NOT a control — only its route link is — so the chip has no hover state.
// Its number is in accent mono beside a neutral unit and label, which is what makes the
// band scan as a gauge cluster and satisfies 1.4.1 by construction: the colour is never
// the carrier, the word is.
import type { Destination } from '../lib/links.ts'

interface Props {
  /** The number-or-name, set in accent mono `tabular-nums`. Measured, never typed. */
  value: string
  /** The rest of the sentence — the unit, the condition, the full stop — in neutral text. */
  rest: string
  /** The route that proves it. One record per destination, so a second wording for the same
   *  URL cannot be introduced anywhere on the page without adding a second entry (R-15). */
  route: Destination
}
const { value, rest, route } = Astro.props
---

{/* The chip is a flex column (global.css) and the route link takes `margin-block-start: auto`,
    so all five links share the band's baseline whether their sentence runs to one line or
    three. §4's `chip sentence → route link 12` stays the sentence's own bottom margin, which
    the auto margin can only add to. */}
<li class="rail-chip sm:col-span-2 lg:col-span-1">
  <p class="mb-3"><span class="num">{value}</span>{rest}</p>
  <a
    class="link mt-auto inline-flex min-h-8 items-center py-1 font-mono text-code"
    href={route.href}>{route.label}</a
  >
</li>
