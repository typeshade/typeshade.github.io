---
// The same layout as a strip of bytes: fields solid, padding hatched. Decorative; the table
// beside it is the accessible version.
import { typedError } from '../lib/typed-error.ts'

const { layout } = typedError()

interface Run {
  readonly kind: 'field' | 'pad'
  readonly bytes: number
}
const runs: Run[] = []
let at = 0
for (const f of layout.fields) {
  if (f.offset > at) runs.push({ kind: 'pad', bytes: f.offset - at })
  runs.push({ kind: 'field', bytes: f.size })
  at = f.offset + f.size
}
if (layout.size > at) runs.push({ kind: 'pad', bytes: layout.size - at })
const cells = runs.reduce((n, r) => n + r.bytes, 0)
if (cells !== layout.size) throw new Error(`[ByteRuler] the runs cover ${cells} bytes; the block is ${layout.size}`)

const stops = [...new Set([0, ...layout.fields.flatMap((f) => [f.offset, f.offset + f.size]), layout.size])].sort(
  (a, b) => a - b,
)
---

<div aria-hidden="true">
  <div class="byte-ruler">
    {
      runs.map((run) =>
        Array.from({ length: run.bytes }, (_, i) => (
          <span class:list={['cell', run.kind === 'pad' && 'pad', i === 0 && 'run-start']} />
        )),
      )
    }
  </div>
  <p class="mono mt-2 text-text-3">bytes {stops.join(', ')}</p>
</div>
