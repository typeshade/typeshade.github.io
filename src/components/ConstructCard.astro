---
// One TypeScript construct on /guide/language/from-typescript/, as an Ant Card. The card
// itself is what separates one construct from the next, so a reader can see where a
// construct ends even when its code runs tall, and the code sits in two panes instead of
// three table columns, which gives each pane about twice the width a cell had. It sits
// beside MappingTable.astro: use the table where a row is a one-line spelling, and this
// where a row is a whole program beside the shader text it emits.
//
// Props
//   locale     the page's locale, passed on to <Code> so the copy button speaks it.
//   name       the construct's name, from the dictionary. Rendered through Rich, so it may
//              carry backticked code: most constructs are named by the keyword spelling them.
//   becomes    one sentence saying what the construct becomes, the copy that used to be the
//              table's middle column and now runs at the card's full width. Rich, so it may
//              carry code and a [text](linkKey) link to the .shade.ts example that uses it.
//   ts         the TypeScript, taken from the program the build compiles. Not copy.
//   tsTitle    the title bar over the left pane. One pair of titles serves the whole page,
//              so no card repeats a column heading.
//   emitTitle  the title bar over the right pane.
//   wgsl       the emitted WGSL, or null on a construct the compiler refuses.
//   diagnostic the compiler's own code and message, on a construct it refuses. A card
//              carries one of `wgsl` and `diagnostic`, and a card with both or with neither
//              stops the build.
//   refusedLabel     the badge beside the name of a refused construct.
//   diagnosticTitle  the label over the refusal, where an emitting card has its title bar.
//
// CSS: src/styles/global.css, under "The construct card". The classes are .construct-cards,
// .construct-card, .construct-card-head, .construct-card-name, .construct-card-badge,
// .construct-card-note, .construct-card-panes, .construct-card-pane,
// .construct-card-pane-title and .construct-card-refusal. The panes sit side by side from
// 48rem and stack below it, the TypeScript first.
import { Code } from 'astro-expressive-code/components'
import CodeFrame from './CodeFrame.astro'
import Rich from './Rich.astro'
import type { Locale } from '../i18n/index.ts'

// Named on a line of its own: the Astro compiler hoists an exported type alias by taking the
// text up to its last closing brace, the way MappingTable.astro's header comment describes.
export type ConstructDiagnostic = { readonly code: string; readonly message: string }

interface Props {
  locale: Locale
  name: string
  becomes: string
  ts: string
  tsTitle: string
  emitTitle: string
  wgsl: string | null
  diagnostic: ConstructDiagnostic | null
  refusedLabel: string
  diagnosticTitle: string
}
const { locale, name, becomes, ts, tsTitle, emitTitle, wgsl, diagnostic, refusedLabel, diagnosticTitle } = Astro.props

if ((wgsl === null) === (diagnostic === null)) {
  const what = wgsl === null ? 'no emit and no diagnostic' : 'an emit and a diagnostic at once'
  throw new Error(`[ConstructCard] '${name}' carries ${what}`)
}

// The accessible name of a code region: the pane's title and the construct it belongs to, so
// a reader walking the page's regions hears which card each one is in. The backticks in the
// name are markup for Rich and have no place in a label.
const plain = name.replace(/`/g, '')
const region = (title: string): string => `${title}, ${plain}`
---

<li class="construct-card">
  <div class="construct-card-head">
    <h3 class="construct-card-name"><Rich text={name} locale={locale} /></h3>
    {diagnostic && <span class="construct-card-badge">{refusedLabel}</span>}
  </div>
  <p class="construct-card-note"><Rich text={becomes} locale={locale} /></p>
  <div class="construct-card-panes">
    <div class="construct-card-pane">
      <CodeFrame label={region(tsTitle)} holdTokens>
        <Code code={ts} lang="ts" title={tsTitle} locale={locale} wrap />
      </CodeFrame>
    </div>
    {wgsl !== null ? (
      <div class="construct-card-pane">
        <CodeFrame label={region(emitTitle)} holdTokens>
          <Code code={wgsl} lang="wgsl" title={emitTitle} locale={locale} wrap />
        </CodeFrame>
      </div>
    ) : (
      <div class="construct-card-pane construct-card-refusal">
        <p class="construct-card-pane-title">{diagnosticTitle}</p>
        <p class="diagnostic">{diagnostic!.code.length > 0 && <b>{diagnostic!.code}</b>} {diagnostic!.message}</p>
      </div>
    )}
  </div>
</li>
