---
// B1.EMIT — design §5 "Emit card, ladder and count", IA §4.3, deck §5 `write`.
//
// Four rows on a 2-cell grid (16 px arrow column + value), hairline-ruled, every value read
// from `hero.emit`. The card MEASURES the output and never prints it (P4, R-6) — which is why
// each row names the SHAPE before the number: one module against two stages, so a reader is
// never invited to compare 29 with 34 as if they measured the same thing.
//
// Rows 1-3 are the deck's own wordings with their build-time numerals. Row 4 is the deck's
// byte-identity claim rendered as the LINK that carries it — `goldens diff byte for byte` —
// which is a ratified amendment recorded in deck §10, for three reasons that all outlive this
// file: this site keeps no golden and could not check "byte-identical to the last build" on
// its own build (R-4); design §5 makes `B1.EMIT`'s fourth row that `(href, text)` pair, the
// same one `B2.COUNT` and the rail's chip 2 use, which is what keeps R-15 injective across
// three sections; and §8's focus order counts it as stop 16. It therefore also takes the
// >= 24 x 24 target treatment those two carry, which this row measured 17 px tall without.
import { hero } from '../lib/examples.ts'
import { links } from '../lib/links.ts'
import Plate from './Plate.astro'

const kb = (hero.emit.payloadBytes / 1024).toFixed(1)
const glslLines = hero.emit.glslVertexLines + hero.emit.glslFragmentLines
---

<Plate label="Emitted · measured, never listed" labelWord flush>
  <ul class="list-none p-0">
    <li class="emit-row px-4">
      <span aria-hidden="true">→</span>
      <span>WGSL · one module, <span class="num">{hero.emit.wgslLines}</span> lines</span>
    </li>
    <li class="emit-row px-4">
      <span aria-hidden="true">→</span>
      <span>GLSL ES 3.00 · two stages, <span class="num">{glslLines}</span> lines</span>
    </li>
    <li class="emit-row px-4">
      <span></span>
      <span><span class="num">{kb}</span> KB inlined here</span>
    </li>
    <li class="emit-row px-4">
      <span></span>
      <span
        ><a class="link inline-flex min-h-8 items-center py-1" href={links.goldens.href}
          >{links.goldens.label}</a
        ></span
      >
    </li>
  </ul>
</Plate>
