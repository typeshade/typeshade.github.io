---
// The snippet with the wrong field, marked, and the TypeScript diagnostic it produces.
// The message is the compiler's own text, from src/lib/typed-error.ts.
import { Code } from 'astro-expressive-code/components'
import { typedError } from '../lib/typed-error.ts'
import CodeFrame from './CodeFrame.astro'

const { snippet, wrongLine, diagnostic } = typedError()
const TITLE = 'typed-error-shader.ts'
---

<div data-diagnostic>
  <CodeFrame label={`Shader with a misspelt field, ${TITLE}`}>
    <Code code={snippet} lang="ts" title={TITLE} meta={`{${wrongLine}}`} />
  </CodeFrame>
  <p class="diagnostic mt-3">
    <b>error TS{diagnostic.code}</b> at line {diagnostic.line}, column {diagnostic.column}: {diagnostic.message}
    {diagnostic.truncated && <span>(first line of a longer message)</span>}
  </p>
</div>

<style is:global>
  [data-diagnostic] .expressive-code .ec-line.mark {
    text-decoration: underline wavy var(--color-diag);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
