---
// RAIL — design §4 (rhythm, grid) and §5 (chip, anchor marker), IA §4.3 `RAIL.*`, copy deck §4.
//
// Five one-sentence chips at fold + 1, so the credibility band is seen without a gesture (P3).
// Shape is IA X5's — one sentence with its number-or-name AND its condition, each with a
// linked route; the words are the deck's, and its five surviving slots are the deck's six
// minus `MIT`, which design §0 moved to §adopt's state chips.
//
// The five claims and the commit rung live in `src/lib/rail.ts`, because /llms.txt publishes
// the same five with the same routes (R-14) — one record, two renderings.
//
// The five chips share ONE continuous top rule across the band — which is why the rail may
// never become a 2-column grid: it reflows 5 x 1 -> 3 + 2 -> 1 x 5 (§7).
//
// The `h2` names WHEN the compilers ran, not whose CI ran them (IA X4, R-4): the gate is the
// mirror's own and runs on every push, so `on every push` is what stops the line being read as
// a claim about THIS build. It is 7 words — the deck's <= 8-word cap needs no exception now.
import { links } from '../lib/links.ts'
import { railClaims } from '../lib/rail.ts'
import RailChip from './RailChip.astro'

// One string, rendered once and named once: the `h2` carries it as its accessible name so the
// anchor marker inside it is not concatenated into every heading a screen-reader user browses
// by (the same rule as `SectionHeading.astro`).
const HEADING = 'Checked by real compilers, on every push.'
---

<section id="rail" class="py-10 lg:py-14">
  <div class="mx-auto w-[var(--content)]">
    <h2 class="text-meta font-medium tracking-[0.01em] text-text-3" aria-label={HEADING}>
      {HEADING}{' '}
      {/* The anchor marker takes the link atom whole — accent, and the persistent underline
          D-7 made the sole non-colour affordance cue. The `#` is aria-hidden so the marker
          has no visible text label of its own, and the label names its section, which is
          what keeps the seven markers' accessible names distinct (R-15). */}
      <a class="anchor link" href="#rail" aria-label="Permalink to rail"
        ><span aria-hidden="true">#</span></a
      >
    </h2>

    <ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6 lg:grid-cols-5">
      {railClaims.map((claim) => <RailChip value={claim.value} rest={claim.rest} route={claim.route} />)}
    </ul>

    {/* RAIL.COMMIT — the `Check the pinned commit` rung. The hash IS the link text (deck §4),
        and it is the only link here: the sentence names the act, the hash performs it. `py-1`
        is §recognise's and the footer's treatment for a route inside prose: §8 licenses ONE
        inline exception and it is §types' `reflect()`, so 17 px tall was not an option. */}
    <p class="text-meta mt-8 text-text-2">
      Check the pinned commit — every shader on this page was emitted at build time from{' '}
      <a class="link py-1" href={links.commit.href}>{links.commit.label}</a>.
    </p>
  </div>
</section>
