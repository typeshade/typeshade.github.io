---
// §adopt · "Where it runs" — IA beat 5, pillar P-3, deck §5 `adopt`, design §4 (centred, span
// 8 → 792) and §5.
//
// One production consumer is named because there is exactly one; a logo band would be three
// empty cells and an evaluator counts them. "Unreleased" is answered with a named production
// consumer, never with an apology — which is why the body states the release status as the
// ask's precondition rather than as a caveat.
//
// The chips are PLAIN TEXT, not links (design §0 over deck §5): the rail already owns those
// routes, and a second wording for one of them would breach R-15.
//
// The two CTAs render from the SAME records as the hero, so "one destination, one wording" is
// a property of the code rather than a string comparison between two places.
import { facts } from '../../lib/examples.ts'
import { links } from '../../lib/links.ts'
import InstallCommand from '../InstallCommand.astro'
import SectionHeading from '../SectionHeading.astro'
import StateChip from '../StateChip.astro'

const chips = [
  { value: `${facts.runtimeDeps}`, text: 'runtime dependencies' },
  { text: facts.packageName },
  { text: facts.license },
  { text: `pinned ${facts.pinnedCommit}` },
]
---

<section id="adopt" class="py-28 lg:py-40">
  <div class="mx-auto w-[var(--content)]">
    <div class="mx-auto lg:w-[calc(var(--content)*8/12-8px)]">
      <SectionHeading id="adopt" text="No engine. No dependencies." size="h2-lg" />
      <p class="text-lead mt-6 tracking-[-0.003em] text-text-2 lg:tracking-[-0.006em]">
        In production today inside the X-GIS globe engine. {facts.nextVersion} is not published
        yet — start from the mirror and the guide.
      </p>

      <div class="mt-8 flex flex-wrap gap-2">
        {chips.map((chip) => <StateChip value={chip.value} text={chip.text} />)}
      </div>

      <div class="mt-8">
        <InstallCommand />
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
        <a class="btn-primary" href={links.guide.href}
          >{links.guide.label}<span aria-hidden="true">→</span></a
        >
        <a class="btn-ghost" href={links.mirror.href}>{links.mirror.label}</a>
      </div>

      {/* `B5.WATCH` — the page's only retention instrument, and it holds no account, no list
          and no visitor data: no email, no waitlist, no urgency device. */}
      <p class="mt-6">
        <a class="link link-tertiary" href={links.releases.href}
          >{links.releases.label}<span aria-hidden="true">→</span></a
        >
      </p>
    </div>
  </div>
</section>
