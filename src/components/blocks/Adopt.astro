---
import { facts } from '../../lib/examples.ts'
import { links } from '../../lib/links.ts'
import InstallCommand from '../InstallCommand.astro'
---

<section id="adopt" class="section">
  <div class="wrap">
    <h2>No engine, no runtime dependencies.</h2>
    <p class="lead mt-5">
      TypeShade ships TypeScript source under the {facts.license} licence, with {facts.runtimeDeps} runtime
      dependencies. It does not know about your renderer: you emit strings and hand them to WebGPU or WebGL2 yourself.
    </p>
    <p class="mt-5 text-text-2">
      Version {facts.nextVersion} is not on npm yet, so the way to use it today is as a git submodule. The repository
      root is the package, and it type-checks on its own with <code class="mono">tsc -p .</code>.
    </p>
    <div class="mt-6 max-w-2xl"><InstallCommand /></div>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a class="btn" href={links.guide.href}>{links.guide.label}</a>
      <a class="btn-ghost" href={links.mirror.href}>{links.mirror.label}</a>
    </div>
    <p class="meta mt-5">
      <a class="link" href={links.releases.href}>{links.releases.label}</a> on GitHub. There is no mailing list.
    </p>
  </div>
</section>
