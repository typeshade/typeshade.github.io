---
import { Code } from 'astro-expressive-code/components'
import { hero } from '../../lib/examples.ts'
import { links } from '../../lib/links.ts'
import ShaderCanvas from '../ShaderCanvas.astro'
import type { CanvasText } from '../ShaderCanvas.astro'
import CodeFrame from '../CodeFrame.astro'

const caption: CanvasText = {
  neutral: 'The gradient pass, rendered at build time.',
  webgpu: 'The gradient pass, drawn on WebGPU.',
  webgl2: 'The gradient pass, drawn on WebGL2.',
  none: 'The gradient pass, rendered at build time. This browser has no WebGPU or WebGL2.',
}
const glslLines = hero.emit.glslVertexLines + hero.emit.glslFragmentLines
const kb = (hero.emit.payloadBytes / 1024).toFixed(1)
---

<section id="write" class="section">
  <div class="wrap">
    <h2>What you write, and what comes out.</h2>
    <p class="lead mt-5">
      This is the fragment stage of a gradient pass, {hero.authoredLines} lines of TypeScript. The compiler emits a{' '}
      {hero.emit.wgslLines}-line WGSL module and two GLSL ES 3.00 stages ({glslLines} lines together) from it. Both
      outputs, with the reflected uniform layout, are {kb} KB on this page.
    </p>
    <div class="mt-8 grid gap-6 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <CodeFrame label={`Authored fragment, ${hero.file}`}>
          <Code code={hero.authored} lang="ts" title={hero.file} />
        </CodeFrame>
      </div>
      <div class="lg:col-span-5">
        <ShaderCanvas example="gradient" aspect="4/3" still caption={caption} />
      </div>
    </div>
    <p class="mt-6 text-text-2">
      Every example in the repository is emitted this way and its output is committed as a golden file, so a change
      to the emitter shows up as a diff. Browse <a class="link" href={links.examplesDir.href}>{links.examplesDir.label}</a>{' '}
      or the <a class="link" href={links.goldens.href}>golden test</a>.
    </p>
  </div>
</section>
