---
// §recognise · "Who writes it twice" — GTM §1.3, deck §5 `whowrites`, design §5 "Recognise
// scan row", IA `BR.*`.
//
// Deliberately UNPLATED: this is the one block that is the reader's voice rather than an
// instrument reading, so it carries no surface, no bezel and no accent numeral in the scan
// row — and that change of register is what stops the page reading as six identical cards.
//
// Body A ships (design §0, D-11): the brief's fact list was amended, so the two Khronos
// figures render with `facts.survey`'s own dated record beside them. They are facts about the
// MARKET, never about TypeShade's audience, which is what keeps them clear of the honesty
// envelope's ban on audience claims.
//
// The three sentences are never a table, at any width (P10) — a reader self-identifies by
// their own description of the pain, and a table would turn that into a comparison grid.
//
// This block carries NO CTA: the seven-verb ladder is full (deck §7), and its `Sources:` line
// is a citation, not a call to action. It is also the ONLY place on the page where a host name
// may appear — in visible text and in the href alike. A citation under a claim is attribution,
// not an integration claim.
import { facts } from '../../lib/examples.ts'
import { links } from '../../lib/links.ts'
import SectionHeading from '../SectionHeading.astro'

const LINES = [
  "Your custom layer's GLSL has an expiry date on the host's roadmap.",
  'Your extension injects GLSL, so it stays WebGL-only until someone rewrites it.',
  'One effect, two programs: the API asks for both, or it will not run.',
]

// Four source links; three of them carry a host name. G11 asserts those as two counts, not one.
const sources = [links.maplibreRoadmap, links.deckglWebgpu, links.pixijsMigration, links.survey]
---

<section id="recognise" class="py-[88px] lg:py-28">
  <div class="mx-auto w-[var(--content)]">
    <SectionHeading id="recognise" text="You have written this twice." />
    <p class="text-lead mt-6 max-w-[var(--measure-body)] tracking-[-0.003em] text-text-2 lg:tracking-[-0.006em]">
      <span class="num">{facts.survey.figure64}%</span> of over{' '}
      <span class="num">{facts.survey.n}</span> shader developers adapt shaders across platforms,
      APIs or tools. About <span class="num">{facts.survey.figure10}%</span> call it one of their
      largest engineering costs.
    </p>

    <div class="scan-row mt-8 lg:mt-12">
      {
        LINES.map((line, i) => (
          <p class="scan-cell">
            {i > 0 && <span class="scan-rule" aria-hidden="true" />}
            <span class="scan-square" aria-hidden="true" />
            {line}
          </p>
        ))
      }
    </div>

    {/* Inline flow, not a flex row: a flex separator is its own item and lands alone at the
        start of a line at 350 (measured). The `·` is glued to the link before it by a
        non-breaking space, so the only break opportunity is BETWEEN sources — and a long
        citation still wraps inside itself, which a flex item of `inline-flex` could not. */}
    <p class="text-meta mt-8 text-text-4">
      <span class="micro-word">Sources:</span>{' '}
      {
        sources.map((source, i) => (
          <>
            <a class="link py-1" href={source.href}>
              {source.label}
            </a>
            {i < sources.length - 1 && <span aria-hidden="true">{'\u00A0· '}</span>}
          </>
        ))
      }
    </p>

    <p class="micro-word mt-4">measured</p>
  </div>
</section>

<style>
  /* The scan row's separators are the gutters' own 1 px rules, positioned INSIDE the second
     and third cells so the grid stays `repeat(3, 1fr)` — a five-column grid would make the
     rules columns, and columns wrap. They are dropped whole when the row stacks (global.css):
     a horizontal rule between three sentences is the list-that-becomes-a-table P10 refuses. */
  .scan-cell {
    position: relative;
  }
  .scan-rule {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(-1 * var(--grid-gap) / 2);
  }
  /* The 4 px square is a shape, not space, so it is exempt from the 8-pt rule (§4). */
  .scan-square {
    display: block;
    inline-size: 4px;
    block-size: 4px;
    margin-block-end: 16px;
    background: var(--color-line-3);
  }
</style>
