---
// The same gradient source mounted twice: left through the WebGPU path, right forced onto
// WebGL2. Captions are written from the backend that actually drew each frame.
import { links } from '../../lib/links.ts'
import ShaderCanvas from '../ShaderCanvas.astro'
import type { CanvasText } from '../ShaderCanvas.astro'

const NONE = 'Rendered at build time. This browser has no WebGPU or WebGL2.'
const gpuCaption: CanvasText = {
  neutral: 'WGSL, compiled by Tint. Rendered at build time.',
  webgpu: 'WGSL, compiled by Tint. Drawn here on WebGPU.',
  webgl2: 'WGSL, compiled by Tint in CI. This browser has no WebGPU, so GLSL ES 3.00 drew this frame on WebGL2.',
  none: NONE,
}
const glCaption: CanvasText = {
  neutral: 'GLSL ES 3.00. Rendered at build time.',
  webgpu: NONE,
  webgl2: 'GLSL ES 3.00. Drawn here on WebGL2.',
  none: NONE,
}

const checks = [
  { text: 'A CPU oracle executes the authored module in double precision, from the same source the emitters read.', source: links.oracle },
  { text: 'Tint compiles the WGSL for every shader variant the X-GIS globe engine emits, on every commit.', source: links.wgslGate },
  { text: 'A real WebGL2 context compiles and links every GLSL ES 3.00 variant, on every commit.', source: links.glslGate },
  { text: 'Golden files diff every emit byte for byte.', source: links.goldens },
]
---

<section id="agree" class="section">
  <div class="wrap">
    <h2>The same source runs on the CPU, on WebGPU and on WebGL2.</h2>
    <p class="lead mt-5">
      That is how the two GPU outputs are checked instead of assumed. The two frames below are the gradient pass from
      the previous section, drawn through each API.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <ShaderCanvas example="gradient" aspect="16/9" still caption={gpuCaption} />
      <ShaderCanvas example="gradient" aspect="16/9" still forceWebGl2 caption={glCaption} />
    </div>
    <ul class="checks mt-8">
      {
        checks.map((c, i) => (
          <li>
            <span>{i + 1}</span>
            <span>
              {c.text}{' '}<a class="link" href={c.source.href}>{c.source.label}</a>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="meta mt-6">
      No pixel comparison between the two backends is committed yet, so none is claimed here. The compile gates run
      in <a class="link" href={links.ciGates.href}>{links.ciGates.label}</a> of the X-GIS repository, which is where
      development happens today.
    </p>
  </div>
</section>
