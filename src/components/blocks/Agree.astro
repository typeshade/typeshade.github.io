---
// §agree · "Proven to agree" — IA beat 2, pillar P-2, deck §5 `agree` and §6, design §5.
//
// The pair is the claim: that same `gradient` source mounted TWICE, left through the WebGPU
// path and right forced onto WebGL2 (R-8). Both draw one frame and stop (R-9) — `gradient`
// declares no `time` control, so there is no shared clock to get wrong, and the two payloads
// are one deduped record (D-8).
//
// Every header and caption is written from `canvas.dataset.backend`, never from the intent
// (I-2). The asymmetric rows below are load-bearing: without them, a browser with no WebGPU
// renders two WebGL2 frames under a header claiming Tint drew one — this page's own
// verification claim, told wrong, on the block that exists to prove it.
import { facts, hero } from '../../lib/examples.ts'
import { links } from '../../lib/links.ts'
import CanvasFigure from '../CanvasFigure.astro'
import type { CanvasText } from '../ShaderCanvas.astro'
import Disclosure from '../Disclosure.astro'
import Ladder from '../Ladder.astro'
import SectionHeading from '../SectionHeading.astro'

// When NEITHER API is present, both headers collapse to this one line, so the section cannot
// show two identical fallbacks under two different backend headers (I-2, design §5).
const BUILD_TIME_ONLY = 'emitted at build time — no GPU API here to run it on'
const NONE_CAPTION =
  'Neither WebGPU nor WebGL2 here — the shaders on this page were still emitted at build time.'

const gpuHeader: CanvasText = {
  neutral: 'WGSL → Tint',
  webgpu: 'WGSL → Tint → WebGPU',
  // WebGPU absent, WebGL2 present: this canvas drew on WebGL2, so the header stops claiming a
  // backend and states the build-time fact instead.
  webgl2: 'no WebGPU here — this WGSL was still emitted at build time',
  none: BUILD_TIME_ONLY,
}
const gpuCaption: CanvasText = {
  neutral: 'WGSL → Tint · checked in CI.',
  webgpu: 'WGSL → Tint → WebGPU · drawn here.',
  webgl2:
    'WGSL → Tint · checked in CI. This browser has no WebGPU, so GLSL ES 3.00 drew this frame.',
  none: NONE_CAPTION,
}
const glHeader: CanvasText = {
  neutral: 'GLSL ES 3.00',
  // This mount skips the WebGPU probe entirely, so `webgpu` is unreachable; it is filled with
  // the line that makes no live claim rather than with a wording that would be a lie if the
  // state ever occurred.
  webgpu: BUILD_TIME_ONLY,
  webgl2: 'GLSL ES 3.00 → WebGL2',
  none: BUILD_TIME_ONLY,
}
const glCaption: CanvasText = {
  neutral: 'GLSL ES 3.00 · emitted at build time.',
  webgpu: NONE_CAPTION,
  webgl2: 'GLSL ES 3.00 → WebGL2 · drawn here.',
  none: NONE_CAPTION,
}

// `B2.NOTE` points back at §write's slice, so its numeral is that slice's — as a word, since
// the note reads as a sentence and the count is already a digit two sections above.
const WORDS: Record<number, string> = { 8: 'eight', 9: 'nine', 10: 'ten', 11: 'eleven', 12: 'twelve' }
const word = WORDS[hero.authoredLines] ?? `${hero.authoredLines}`
---

<section id="agree" class="py-24 lg:py-32">
  <div class="mx-auto w-[var(--content)]">
    <SectionHeading id="agree" text="Agreement is measured, not promised." size="h2-lg" />
    <p class="text-lead mt-6 max-w-[var(--measure-body)] tracking-[-0.003em] text-text-2 lg:tracking-[-0.006em]">
      The same source runs on a CPU in f64. Both emitted shaders are compiled by the real
      compilers, every commit.
    </p>

    {/* The pair stays side by side down to 40rem, because the pair IS the claim (§7). */}
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-12">
      <CanvasFigure example="gradient" still caption={gpuCaption} header={gpuHeader} aspect="16/9" />
      <CanvasFigure
        example="gradient"
        still
        forceWebGl2
        caption={glCaption}
        header={glHeader}
        aspect="16/9"
      />
    </div>

    <p class="micro-word mt-6 text-center text-text-3">
      One source · two compilers · two GPU APIs · the {word} lines above.
    </p>

    {/* The pair IS the claim, and the evidence under it keeps the pair's own rhythm: ladder
        left, disclosure right, each on one 588 px half of the 1200 px band. Collapsed to one
        column the block previously left 628 px of empty right half under the canvases. */}
    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-6">
      <div>
        <Ladder />
        {/* `B2.COUNT` — the same (href, text) pair as the emit card's fourth row and the
            rail's chip 2, which is what keeps that destination's single wording injective
            (R-15), and therefore the same ≥ 24 × 24 target treatment as that chip's route
            (§8): at `micro/code`'s 11 px the bare inline link measured 14 px tall. */}
        <p class="micro-code mt-6 text-text-3">
          <span class="num">{facts.testFiles}</span> test files ·{' '}
          <a class="link inline-flex min-h-8 items-center py-1" href={links.goldens.href}
            >{links.goldens.label}</a
          >
        </p>
      </div>

      <div class="max-w-[var(--measure-body)]">
        <Disclosure />
      </div>
    </div>

    <p class="micro-code mt-4">CPU f64 oracle · Tint · WebGL2</p>
    <p class="mt-8">
      <a class="link link-tertiary" href={links.ciGates.href}
        >{links.ciGates.label}<span aria-hidden="true">→</span></a
      >
    </p>
  </div>
</section>
