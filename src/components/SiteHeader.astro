---
// The bar at the top of every page: the mark and the name, the page links, and the other
// languages this page exists in. Under 48rem the links move into a panel behind a menu
// button; the panel is a details element, so it needs no script.
import { MARK } from '../lib/mark.ts'
import { navLinks } from '../lib/links.ts'
import { copyFor, localePath, locales, type Locale } from '../i18n/index.ts'

interface Props {
  locale: Locale
  path: string
}
const { locale, path } = Astro.props
const t = copyFor(locale)
const others = locales.filter((l) => l !== locale)
// The 404 exists in one language, so its language link goes to the other front page.
const languageLinks = others.map((l) => ({
  locale: l,
  href: localePath(l, /\.[a-z0-9]+$/i.test(path) ? '/' : path),
  label: copyFor(l).name,
}))
---

<header class="site-header">
  <div class="site-header-in">
    <a class="site-name" href={localePath(locale, '/')}>
      <svg viewBox={MARK.viewBox} aria-hidden="true" focusable="false">
        <path
          d={MARK.d}
          fill="none"
          stroke="currentColor"
          stroke-width={MARK.strokeWidth}
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      TypeShade
    </a>
    <nav class="site-nav" aria-label="Primary">
      {navLinks(locale).map((l) => <a href={l.href}>{l.label}</a>)}
      <span class="site-nav-sep" aria-hidden="true"></span>
      {languageLinks.map((l) => <a href={l.href} hreflang={l.locale} lang={l.locale} aria-label={`${t.nav.languages}: ${l.label}`}>{l.label}</a>)}
    </nav>
    <details class="site-menu">
      <summary aria-label={t.nav.menu}>
        <span class="site-menu-bar"></span>
        <span class="site-menu-bar"></span>
        <span class="site-menu-bar"></span>
      </summary>
      <nav class="site-screen" aria-label={t.nav.menu}>
        {navLinks(locale).map((l) => <a href={l.href}>{l.label}</a>)}
        {languageLinks.map((l) => <a href={l.href} hreflang={l.locale} lang={l.locale}>{l.label}</a>)}
      </nav>
    </details>
  </div>
</header>
