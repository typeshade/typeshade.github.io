---
// The bar at the top of every page: the mark and the name; Guide and Examples; then search,
// the language menu, the dark-mode switch and GitHub as icons. Under 48rem the nav, the version
// and language menus and the dark-mode switch sit in a panel behind a menu button, but the
// magnifier stays in the bar so search is one tap either way. Every menu (version, language,
// the phone panel) is a details element; the script in Base.astro keeps only one open at a
// time and closes them on Escape and an outside click. The bar is out of the search index, so
// a hit is a hit in the page's own text.
import { MARK } from '../lib/mark.ts'
import { links, navLinks } from '../lib/links.ts'
import { facts } from '../lib/examples.ts'
import { copyFor, localePath, locales, type Locale } from '../i18n/index.ts'

interface Props {
  locale: Locale
  path: string
}
const { locale, path } = Astro.props
const t = copyFor(locale)
const target = /\.[a-z0-9]+$/i.test(path) ? '/' : path
const languages = locales.map((l) => ({ locale: l, href: localePath(l, target), label: copyFor(l).name, current: l === locale }))
const others = languages.filter((l) => !l.current)
const ordered = [...languages.filter((l) => l.current), ...others]
---

<header class="site-header" data-pagefind-ignore>
  <div class="site-header-in">
    <a class="site-name" href={localePath(locale, '/')}>
      <img src={MARK.src} alt="" width="28" height="28" />
      TypeShade
    </a>
  </div>
</header>
