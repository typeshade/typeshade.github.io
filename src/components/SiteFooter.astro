---
// The site map in three columns, then the licence, the copyright and the commit the page
// was built from.
import Rich from './Rich.astro'
import { facts } from '../lib/examples.ts'
import { docsPages, links } from '../lib/links.ts'
import { copyFor, localePath, locales, type Locale } from '../i18n/index.ts'

interface Props {
  locale: Locale
  path: string
}
const { locale, path } = Astro.props
const t = copyFor(locale)
const columns = [
  {
    h: t.footer.docs,
    items: [
      ...docsPages(locale),
      { label: t.docs.api.h1, href: localePath(locale, links.api.href) },
      { label: t.footer.readme, href: links.docs.href },
    ],
  },
  {
    h: t.footer.project,
    items: [
      { label: t.nav.github, href: links.mirror.href },
      { label: t.footer.releases, href: links.releases.href },
      { label: t.footer.npm, href: links.npm.href },
      { label: t.nav.llms, href: links.llms.href },
    ],
  },
  {
    h: t.footer.languages,
    items: locales.map((l) => ({
      label: copyFor(l).name,
      href: localePath(l, /\.[a-z0-9]+$/i.test(path) ? '/' : path),
      locale: l,
    })),
  },
]
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-map">
    {columns.map((c) => (
      <div class="site-map-col">
        <h2>{c.h}</h2>
        <ul>
          {c.items.map((i) => (
            <li><a href={i.href} lang={'locale' in i ? i.locale : undefined} hreflang={'locale' in i ? i.locale : undefined}>{i.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="site-legal">
    <p><Rich text={t.footer.license} locale={locale} /></p>
    <p>{t.footer.copyright}</p>
    <p>{t.footer.builtFrom} <a href={links.commit.href}>{facts.pinnedCommit}</a>.</p>
  </div>
</footer>
