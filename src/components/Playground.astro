---
import type { Locale } from '../i18n/index.ts'
interface Props { locale: Locale }
const { locale } = Astro.props
const sample = `"use typeshade"

class Clip {
  @builtin("position") pos: vec4
}

class Color {
  @location(0) color: vec4
}

@vertex
export function vs(@builtin("vertex_index") i: u32): Clip {
  const x = i === 1 ? 0.8 : i === 2 ? 0. : -0.8
  const y = i === 2 ? 0.8 : -0.8
  return { pos: vec4(x, y, 0., 1.) }
}

@fragment
export function fs(): Color {
  return { color: vec4(1., 0., 0., 1.) }
}
`
const labels = locale === 'ko'
  ? { run: '컴파일', reset: '예제 복원', editor: 'TypeShade 소스', output: 'WGSL 출력', diagnostics: '진단', idle: '컴파일 대기 중', ready: '컴파일 성공', errors: '컴파일 오류', help: 'Monaco 기반 TypeScript 편집기에서 TypeShade를 작성합니다.' }
  : { run: 'Compile', reset: 'Reset example', editor: 'TypeShade source', output: 'WGSL output', diagnostics: '진단', idle: 'Ready to compile', ready: 'Compiled successfully', errors: 'Compile errors', help: 'Author TypeShade in a Monaco-based TypeScript editor.' }
---

<section class="ts-playground" data-playground>
  <div class="playground-toolbar">
    <div><strong>hello.shade.ts</strong><span>{labels.help}</span></div>
    <div class="playground-actions"><button type="button" data-reset>{labels.reset}</button><button type="button" class="primary" data-run>{labels.run}</button></div>
  </div>
  <div class="playground-grid">
    <section class="pane source-pane">
      <div class="pane-title"><span>{labels.editor}</span><kbd>TS</kbd></div>
      <div class="editor-host" data-editor aria-label={labels.editor}></div>
    </section>
    <section class="pane output-pane">
      <div class="pane-title"><span>{labels.output}</span><span data-status>{labels.idle}</span></div>
      <pre data-output aria-live="polite"></pre>
      <div class="diagnostics"><div class="diagnostics-title">{labels.diagnostics}</div><div data-diagnostics>{labels.idle}</div></div>
    </section>
  </div>
</section>

<script define:vars={{ sample, locale }}>
  import { compileTsSource } from '../../vendor/shader-dsl/src/index.ts'

  const root = document.querySelector('[data-playground]')

  if (root instanceof HTMLElement) {
    const editorHost = root.querySelector('[data-editor]')
    const output = root.querySelector('[data-output]')
    const diagnostics = root.querySelector('[data-diagnostics]')
    const status = root.querySelector('[data-status]')
    const run = root.querySelector('[data-run]')
    const reset = root.querySelector('[data-reset]')

    if (editorHost instanceof HTMLElement && output instanceof HTMLElement && diagnostics instanceof HTMLElement && status instanceof HTMLElement && run instanceof HTMLButtonElement && reset instanceof HTMLButtonElement) {
      const copy = locale === 'ko'
        ? { ready: '컴파일 성공', errors: '컴파일 오류', idle: '컴파일 대기 중', loading: '편집기 불러오는 중…', noOutput: '출력이 없습니다.', directive: '"use typeshade" 지시어가 필요합니다.', position: '클립 공간의 vertex position', vertexIndex: '현재 vertex index', instanceIndex: '현재 instance index', location: 'fragment 입출력 location', vec4: '4차원 GPU 벡터', u32: '부호 없는 32비트 정수', vertex: 'vertex shader 진입점', fragment: 'fragment shader 진입점' }
        : { ready: 'Compiled successfully', errors: 'Compile errors', idle: 'Ready to compile', loading: 'Loading editor…', noOutput: 'No WGSL output.', directive: 'The "use typeshade" directive is required.', position: 'Clip-space vertex position', vertexIndex: 'Current vertex index', instanceIndex: 'Current instance index', location: 'Fragment input/output location', vec4: '4-component GPU vector', u32: 'Unsigned 32-bit integer', vertex: 'Vertex shader entry point', fragment: 'Fragment shader entry point' }

      const builtinSuggestions = [
        ['position', copy.position],
        ['vertex_index', copy.vertexIndex],
        ['instance_index', copy.instanceIndex],
      ]
      const typeSuggestions = [
        ['vec2', '2-component GPU vector'],
        ['vec3', '3-component GPU vector'],
        ['vec4', copy.vec4],
        ['u32', copy.u32],
        ['i32', 'Signed 32-bit integer'],
        ['f32', '32-bit floating-point number'],
      ]

      let editor: any
      let model: any
      let monacoApi: any
      let typeLib: any

      const render = () => {
        if (!editor || !model || !monacoApi) return
        status.textContent = copy.idle
        output.textContent = ''
        diagnostics.textContent = ''
        root.classList.remove('has-errors', 'has-output')
        monacoApi.editor.setModelMarkers(model, 'typeshade-compiler', [])
        try {
          const source = editor.getValue()
          const result = compileTsSource(source, { fileName: 'hello.shade.ts', requireDirective: true })
          const messages = [...result.diagnostics]
          if (!result.hasDirective && messages.length === 0) messages.push({ message: copy.directive, line: 1, character: 1, category: 'error' })
          const markers = messages.map((d: any) => ({
            startLineNumber: Math.max(1, d.line ?? 1),
            startColumn: Math.max(1, d.character ?? 1),
            endLineNumber: Math.max(1, d.line ?? 1),
            endColumn: Math.max(2, (d.character ?? 1) + 1),
            message: d.message,
            severity: String(d.category).toLowerCase() === 'warning' ? monacoApi.MarkerSeverity.Warning : monacoApi.MarkerSeverity.Error,
          }))
          monacoApi.editor.setModelMarkers(model, 'typeshade-compiler', markers)
          if (messages.length > 0) {
            status.textContent = copy.errors
            root.classList.add('has-errors')
            diagnostics.textContent = messages.map((d: any) => `${String(d.category).toUpperCase()} ${d.line}:${d.character} ${d.message}`).join('\n')
          } else {
            status.textContent = copy.ready
            diagnostics.textContent = '✓'
          }
          if (result.wgsl) {
            output.textContent = result.wgsl
            root.classList.add('has-output')
          } else output.textContent = copy.noOutput
        } catch (error) {
          status.textContent = copy.errors
          root.classList.add('has-errors')
          diagnostics.textContent = error instanceof Error ? error.message : String(error)
        }
      }

      const loadMonaco = () => new Promise<any>((resolve, reject) => {
        const w = window as any
        if (w.monaco) {
          resolve(w.monaco)
          return
        }
        const existing = document.querySelector('script[data-monaco-loader]')
        const start = () => {
          const amdRequire = w.require
          if (typeof amdRequire !== 'function') {
            reject(new Error('Monaco loader did not initialize.'))
            return
          }
          amdRequire.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs' } })
          w.MonacoEnvironment = {
            getWorkerUrl: (_moduleId: string, label: string) => {
              const worker = label === 'typescript' || label === 'javascript' ? 'language/typescript/tsWorker.js' : 'base/worker/workerMain.js'
              const base = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/'
              const source = `self.MonacoEnvironment={baseUrl:${JSON.stringify(base)}};importScripts(${JSON.stringify(base + worker)});`
              return `data:text/javascript;charset=utf-8,${encodeURIComponent(source)}`
            },
          }
          amdRequire(['vs/editor/editor.main'], () => resolve(w.monaco), reject)
        }
        if (existing) {
          existing.addEventListener('load', start, { once: true })
          start()
          return
        }
        const script = document.createElement('script')
        script.src = 'https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.js'
        script.async = true
        script.dataset.monacoLoader = 'true'
        script.addEventListener('load', start, { once: true })
        script.addEventListener('error', () => reject(new Error('Unable to load Monaco editor.')), { once: true })
        document.head.appendChild(script)
      })

      status.textContent = copy.loading
      loadMonaco().then((monaco) => {
        monacoApi = monaco
        monaco.languages.typescript.typescriptDefaults.setCompilerOptions({
          target: monaco.languages.typescript.ScriptTarget.ES2022,
          module: monaco.languages.typescript.ModuleKind.ESNext,
          moduleResolution: monaco.languages.typescript.ModuleResolutionKind.NodeJs,
          allowNonTsExtensions: true,
          experimentalDecorators: true,
          strict: true,
        })
        monaco.languages.typescript.typescriptDefaults.setDiagnosticsOptions({ noSemanticValidation: false, noSyntaxValidation: false })
        typeLib = monaco.languages.typescript.typescriptDefaults.addExtraLib(`
          declare type vec2 = { x: number; y: number }
          declare type vec3 = { x: number; y: number; z: number }
          declare type vec4 = { x: number; y: number; z: number; w: number }
          declare type u32 = number
          declare type i32 = number
          declare type f32 = number
          declare function vec2(x: number, y: number): vec2
          declare function vec3(x: number, y: number, z: number): vec3
          declare function vec4(x: number, y: number, z: number, w: number): vec4
          declare function builtin(name: string): PropertyDecorator
          declare function location(index: number): PropertyDecorator
          declare const vertex: MethodDecorator
          declare const fragment: MethodDecorator
        `, 'file:///types/typeshade.d.ts')

        model = monaco.editor.createModel(sample, 'typescript', monaco.Uri.parse('file:///hello.shade.ts'))
        editor = monaco.editor.create(editorHost, {
          model,
          automaticLayout: true,
          minimap: { enabled: false },
          fontSize: 13,
          lineHeight: 21,
          tabSize: 2,
          insertSpaces: true,
          wordWrap: 'off',
          scrollBeyondLastLine: false,
          padding: { top: 14, bottom: 14 },
          suggest: { showMethods: true, showFunctions: true, showTypes: true, showWords: true },
          quickSuggestions: true,
          roundedSelection: false,
        })

        monaco.languages.registerCompletionItemProvider('typescript', {
          triggerCharacters: ['@', '"', ':'],
          provideCompletionItems: (currentModel: any, position: any) => {
            if (currentModel.uri.toString() !== model.uri.toString()) return { suggestions: [] }
            const line = currentModel.getLineContent(position.lineNumber).slice(0, position.column - 1)
            const inBuiltin = /@builtin\("[^"]*$/.test(line)
            const inType = /:\s*[A-Za-z0-9_]*$/.test(line)
            const inDecorator = /(^|\s)@[A-Za-z]*$/.test(line)
            const range = new monaco.Range(position.lineNumber, position.column, position.lineNumber, position.column)
            if (inBuiltin) return { suggestions: builtinSuggestions.map(([label, detail]) => ({ label, kind: monaco.languages.CompletionItemKind.EnumMember, insertText: label + '"', detail, range })) }
            if (inType) return { suggestions: typeSuggestions.map(([label, detail]) => ({ label, kind: monaco.languages.CompletionItemKind.TypeParameter, insertText: label, detail, range })) }
            if (inDecorator) return { suggestions: ['builtin', 'location', 'vertex', 'fragment'].map((label) => ({ label, kind: monaco.languages.CompletionItemKind.Keyword, insertText: label, detail: label === 'vertex' ? copy.vertex : label === 'fragment' ? copy.fragment : `@${label}`, range })) }
            return { suggestions: [] }
          },
        })

        monaco.languages.registerHoverProvider('typescript', {
          provideHover: (currentModel: any, position: any) => {
            if (currentModel.uri.toString() !== model.uri.toString()) return null
            const word = currentModel.getWordAtPosition(position)
            if (!word) return null
            const docs: Record<string, string> = {
              vec2: typeSuggestions[0][1], vec3: typeSuggestions[1][1], vec4: copy.vec4, u32: copy.u32,
              i32: 'Signed 32-bit integer', f32: '32-bit floating-point number',
              position: copy.position, vertex_index: copy.vertexIndex, instance_index: copy.instanceIndex,
              vertex: copy.vertex, fragment: copy.fragment, builtin: '@builtin(name) declares a GPU builtin binding.', location: '@location(index) declares a GPU location binding.',
            }
            const doc = docs[word.word]
            return doc ? { contents: [{ value: `**${word.word}**` }, { value: doc }] } : null
          },
        })

        editor.onDidChangeModelContent(() => {
          window.clearTimeout(editor.__typeshadeTimer)
          editor.__typeshadeTimer = window.setTimeout(render, 350)
        })
        run.addEventListener('click', render)
        reset.addEventListener('click', () => {
          editor.setValue(sample)
          render()
          editor.focus()
        })
        render()
      }).catch((error) => {
        status.textContent = copy.errors
        root.classList.add('has-errors')
        diagnostics.textContent = error instanceof Error ? error.message : String(error)
      })
    }
  }
</script>

<style>
  .ts-playground { border: 1px solid var(--color-line-1); border-radius: var(--radius-md); overflow: hidden; background: var(--color-surface-1); }
  .playground-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 14px; border-bottom: 1px solid var(--color-line-1); background: var(--color-ground); }
  .playground-toolbar strong { display: block; font: 500 .875rem/1.4 var(--font-mono); }
  .playground-toolbar span { display: block; margin-top: 2px; color: var(--color-text-3); font-size: .75rem; }
  .playground-actions { display: flex; gap: 8px; }
  .playground-actions button { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 7px 11px; background: var(--color-ground); color: var(--color-text-1); font: 500 .75rem/1.3 var(--font-sans); cursor: pointer; }
  .playground-actions button:hover { background: var(--color-surface-1); }
  .playground-actions .primary { border-color: var(--color-accent); background: var(--color-accent); color: white; }
  .playground-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .pane { min-width: 0; }
  .source-pane { border-bottom: 1px solid var(--color-line-1); }
  .pane-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 12px; color: var(--color-text-2); font-size: .75rem; font-weight: 500; background: var(--color-surface-2); }
  .pane-title kbd, .pane-title [data-status] { color: var(--color-text-3); font: 500 .6875rem/1.3 var(--font-mono); }
  .editor-host, pre { box-sizing: border-box; width: 100%; min-height: 480px; margin: 0; border: 0; border-radius: 0; background: var(--color-ground); color: var(--color-text-1); font: 400 .8125rem/1.65 var(--font-mono); }
  .editor-host { overflow: hidden; }
  pre { padding: 16px; overflow: auto; white-space: pre; }
  .diagnostics { min-height: 96px; padding: 12px 16px; border-top: 1px solid var(--color-line-1); background: var(--color-surface-1); }
  .diagnostics-title { margin-bottom: 6px; color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  [data-diagnostics] { white-space: pre-wrap; color: var(--color-text-2); font: 400 .75rem/1.55 var(--font-mono); }
  .has-errors [data-status] { color: var(--color-diag); }
  .has-errors .diagnostics { border-top-color: var(--color-diag); }
  .has-output [data-status] { color: var(--color-accent); }
  @media (min-width: 64rem) { .playground-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .source-pane { border-bottom: 0; border-right: 1px solid var(--color-line-1); } }
  @media (max-width: 48rem) { .playground-toolbar { align-items: flex-start; flex-direction: column; } .playground-actions { width: 100%; } .playground-actions button { flex: 1; } }
</style>
