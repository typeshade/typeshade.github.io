---
import Rich from './Rich.astro';
import { copyFor, type Locale } from '../i18n/index.ts';
import { defaultPlaygroundExample, playgroundExamples } from '../lib/playground-examples.ts';

interface Props {
  locale: Locale;
  /** The example to open, for a page that already names one. The picker goes with it and
   *  the page carries that example's source alone instead of all of them. */
  seed?: string;
  /** The build-time still of the seeded example, shown in the frame until the reader's own
   *  program has drawn a frame over it. */
  still?: string;
}
const { locale, seed, still } = Astro.props;
const t = copyFor(locale).playground;

// The examples arrive from the vendored checkout at build time: the source text from the
// file, the title and the description from this locale's dictionary. `_shade.ts` reads the
// filesystem, so the browser half never imports it. The words are the gallery's, under
// `examples.shade`, so the picker and the tile on /guide/examples/ cannot disagree.
const shade = copyFor(locale).examples.shade;
const all = playgroundExamples().map((example) => ({
  id: example.id,
  source: example.source,
  title: shade.titles[example.id]!,
  description: shade.descriptions[example.id]!,
}));
if (seed && !all.some((example) => example.id === seed)) {
  throw new Error(`[playground] no .shade.ts example '${seed}' to seed the editor with`);
}
const examples = seed ? all.filter((example) => example.id === seed) : all;
// The name over the toolbar is the file the editor holds, so a seeded page names its own.
const fileName = seed ? `${seed}.shade.ts` : t.fileName;
const sample = `"use typeshade";

class Clip {
  @builtin("position") pos: vec4;
}

class Color {
  @location(0) color: vec4;
}

@vertex
export function vs(@builtin("vertex_index") i: u32): Clip {
  const x = i === 1 ? 0.8 : i === 2 ? 0. : -0.8;
  const y = i === 2 ? 0.8 : -0.8;
  return { pos: vec4(x, y, 0., 1.) };
}

@fragment
export function fs(): Color {
  return { color: vec4(1., 0., 0., 1.) };
}
`;
// The words the browser half needs once it is running. It reads them off the element, since
// the script that holds the logic is a bundled module and takes no `define:vars`.
const runtimeCopy = {
  fileName,
  idle: t.idle,
  ready: t.ready,
  errors: t.errors,
  loading: t.loading,
  clean: t.clean,
  noOutput: t.noOutput,
  directive: t.directive,
  unavailable: t.unavailable,
  starting: t.starting,
  serviceFailed: t.serviceFailed,
  sourceTypescript: t.sourceTypescript,
  sourceTypeshade: t.sourceTypeshade,
  entryPoints: t.entryPoints,
  resources: t.resources,
  inputs: t.inputs,
  outputs: t.outputs,
  returns: t.returns,
  runCpu: t.runCpu,
  running: t.running,
  cpuIdle: t.cpuIdle,
  noResources: t.noResources,
  noEntryPoints: t.noEntryPoints,
  requiredFeatures: t.requiredFeatures,
  cpuFailed: t.cpuFailed,
  canvas: t.canvas,
  draw: t.draw,
  stop: t.stop,
  canvasIdle: t.canvasIdle,
  engineGpu: t.engineGpu,
  engineCpu: t.engineCpu,
  gpuIdle: t.gpuIdle,
  gpuWebgpu: t.gpuWebgpu,
  gpuWebgl2: t.gpuWebgl2,
  gpuNone: t.gpuNone,
  gpuNeedsStages: t.gpuNeedsStages,
  gpuNeedsAttributes: t.gpuNeedsAttributes,
  gpuNeedsBindings: t.gpuNeedsBindings,
  gpuNoWebgpu: t.gpuNoWebgpu,
  gpuNoWebgl2: t.gpuNoWebgl2,
  gpuNoGlsl: t.gpuNoGlsl,
  gpuFailed: t.gpuFailed,
  computeNeedsWebgpu: t.computeNeedsWebgpu,
  computeRan: t.computeRan,
  cpuTextures: t.cpuTextures,
  bindings: t.bindings,
  canvasNeedsVertex: t.canvasNeedsVertex,
  canvasFlat: t.canvasFlat,
  canvasFlatInputs: t.canvasFlatInputs,
  canvasTooBig: t.canvasTooBig,
  canvasProgress: t.canvasProgress,
  resolution: t.resolution,
  canvasDrawn: t.canvasDrawn,
  args: t.args,
  argsInvalid: t.argsInvalid,
  cpuNoResources: t.cpuNoResources,
  entryCountOne: t.entryCount(1),
  noGlsl: t.noGlsl,
  resultTab: t.resultTab,
  copy: t.copy,
  copied: t.copied,
  share: t.share,
  shared: t.shared,
  emit: t.emit,
};
---

<section
  class="ts-playground"
  data-playground
  data-sample={sample}
  data-examples={JSON.stringify(examples)}
  data-default-example={seed ?? defaultPlaygroundExample}
  data-copy={JSON.stringify(runtimeCopy)}
>
  <div class="playground-toolbar">
    <div class="playground-pick">
      <strong>{fileName}</strong>
      {!seed && (
        <div class="pick-row">
          <label for="playground-example">{t.exampleLabel}</label>
          <select id="playground-example" data-example>
            {examples.map((example) => <option value={example.id}>{example.title}</option>)}
          </select>
        </div>
      )}
      {!seed && <p data-example-note>{examples[0]?.description}</p>}
    </div>
    <div class="playground-actions"><button type="button" data-share>{t.share}</button><button type="button" data-reset>{t.reset}</button><button type="button" class="primary" data-run>{t.run}</button></div>
  </div>
  <div class="playground-options" role="group" aria-label={t.emit.title}>
    <div>
      <label for="playground-level">{t.emit.optimization}</label>
      <select id="playground-level" data-opt-level>
        <option value="O0">{t.emit.levels.O0}</option>
        <option value="O1">{t.emit.levels.O1}</option>
        <option value="O2" selected>{t.emit.levels.O2}</option>
      </select>
    </div>
    <div>
      <label for="playground-parens">{t.emit.parens}</label>
      <select id="playground-parens" data-opt-parens>
        <option value="full" selected>full</option>
        <option value="minimal">minimal</option>
      </select>
    </div>
    <div>
      <label for="playground-precision">{t.emit.precision}</label>
      <select id="playground-precision" data-opt-precision>
        <option value="highp" selected>highp</option>
        <option value="mediump">mediump</option>
      </select>
    </div>
    {/* Which primitives back the emulated-double helpers. It goes to reflect() as well as
        to the emit: the `float` helpers bind an `_fp64` guard texture and the `integer` ones
        bind none, so a reflection computed under the other flavour names a binding the
        emitted module does not have. */}
    <div>
      <label for="playground-fp64">{t.emit.fp64}</label>
      <select id="playground-fp64" data-opt-fp64>
        <option value="float" selected>float</option>
        <option value="integer">integer</option>
      </select>
    </div>
    <div class="playground-check">
      <input type="checkbox" id="playground-minify" data-opt-minify />
      <label for="playground-minify">{t.emit.minify}</label>
    </div>
    {/* How minify re-spells a float literal. It has no effect with minify off, so it is
        shown with it. */}
    <div data-numbers-field hidden>
      <label for="playground-numbers">{t.emit.numbers}</label>
      <select id="playground-numbers" data-opt-numbers>
        <option value="true" selected>true</option>
        <option value="f32">f32</option>
        <option value="false">false</option>
      </select>
    </div>
    <div class="playground-check">
      <input type="checkbox" id="playground-obfuscate" data-opt-obfuscate />
      <label for="playground-obfuscate">{t.emit.obfuscate}</label>
    </div>
    <p data-level-note hidden><Rich text={t.emit.levelNote} locale={locale} /></p>
    <p data-prelude-note hidden><Rich text={t.preludeNote} locale={locale} /></p>
  </div>

  <div class="playground-grid">
    <section class="pane source-pane">
      <div class="pane-title"><span>{t.editor}</span><kbd>TS</kbd></div>
      <div class="editor-host" data-editor aria-label={t.editor}></div>
      <div class="diagnostics">
        <div class="diagnostics-title"><span>{t.diagnostics}</span><span data-status>{t.idle}</span></div>
        <ul data-diagnostics aria-live="polite"></ul>
      </div>
    </section>
    {/* One tab strip over the whole result column: the canvas the module draws, the three
        files the compiler emits from it, and what reflect() recovers. One panel is shown at
        a time; the other panels keep whatever was last painted into them, so a tab switch
        paints nothing and re-runs nothing. */}
    <div class="result-column">
      <div class="pane-title result-head">
        <div class="output-tabs" role="tablist" aria-label={t.output}>
          <button type="button" role="tab" id="pg-tab-result" aria-controls="pg-panel-result" data-target="result" aria-selected="true" tabindex="0">{t.resultTab}</button>
          <button type="button" role="tab" id="pg-tab-wgsl" aria-controls="pg-output" data-target="wgsl" aria-selected="false" tabindex="-1">{t.wgslTab}</button>
          <button type="button" role="tab" id="pg-tab-glslVertex" aria-controls="pg-output" data-target="glslVertex" aria-selected="false" tabindex="-1">{t.glslVertexTab}</button>
          <button type="button" role="tab" id="pg-tab-glslFragment" aria-controls="pg-output" data-target="glslFragment" aria-selected="false" tabindex="-1">{t.glslFragmentTab}</button>
          <button type="button" role="tab" id="pg-tab-reflection" aria-controls="pg-panel-reflection" data-target="reflection" aria-selected="false" tabindex="-1">{t.reflection}</button>
        </div>
        {/* The controls the selected tab owns, one group per tab, in the row the tabs are in. */}
        <div class="canvas-meta" data-meta="result">
          <label for="playground-engine">{t.engine}</label>
          <select id="playground-engine" data-engine>
            <option value="auto" selected>{t.engineGpu}</option>
            <option value="webgpu">WebGPU</option>
            <option value="webgl2">WebGL2</option>
            <option value="cpu">{t.engineCpu}</option>
          </select>
          <label for="playground-resolution" data-cpu-only hidden>{t.resolution}</label>
          <select id="playground-resolution" data-resolution data-cpu-only hidden>
            <option value="64">64 × 48</option>
            <option value="128">128 × 96</option>
            <option value="192" selected>192 × 144</option>
            <option value="384">384 × 288</option>
            <option value="768">768 × 576</option>
            <option value="1536">1536 × 1152</option>
            <option value="3840">3840 × 2880 (4K)</option>
            <option value="7680">7680 × 5760 (8K)</option>
          </select>
          <button type="button" data-draw-cpu data-cpu-only hidden disabled>{t.draw}</button>
        </div>
        <div class="output-meta" data-meta="text" hidden>
          <span data-size></span>
          <button type="button" data-copy-output>{t.copy}</button>
        </div>
        <div class="reflect-meta" data-meta="reflection" hidden>
          <button type="button" data-run-cpu disabled>{t.runCpu}</button>
        </div>
      </div>
      <div class="result-panels">
        {/* Two canvases, one shown. The GPU one runs the program the WGSL and GLSL tabs
            hold, through the same runtime every figure on the site uses; the CPU one runs
            the fragment entry once per pixel through the oracle, which answers a different
            question and is the fallback where there is no GPU API at all. A canvas takes one
            context and these take two, so they are two elements and not one. */}
        <div class="canvas-host" id="pg-panel-result" role="tabpanel" aria-labelledby="pg-tab-result">
          {/* One frame for every engine, the width of the column at 4:3. The still of a seeded
              example sits under the canvas until the reader's program has drawn. */}
          <div class="gpu-frame" data-gpu-frame>
            {still && <img src={still} alt="" loading="eager" decoding="async" />}
            <canvas data-gpu-canvas data-backend="none" role="img" aria-label={t.canvas}></canvas>
            <canvas data-canvas width="192" height="144" aria-label={t.canvas} data-cpu-only hidden></canvas>
          </div>
          <p data-gpu-note>{t.gpuIdle}</p>
          <p data-canvas-note data-cpu-only hidden>{t.canvasIdle}</p>
          {/* Every binding and override the module declares, each with what the reader
              supplies it with. Built by src/scripts/playground-bindings.ts after a compile. */}
          <div class="bindings" data-bindings hidden role="group" aria-label={t.bindings.title}></div>
        </div>
        <pre id="pg-output" role="tabpanel" aria-labelledby="pg-tab-wgsl" data-output aria-live="polite" hidden></pre>
        <div class="reflection" id="pg-panel-reflection" role="tabpanel" aria-labelledby="pg-tab-reflection" data-reflection aria-live="polite" hidden></div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/playground.ts';
</script>

<style>
  /* The page field is Ant's layout ground (src/styles/global.css), so the tool's own region
     is a white container on it, the way the docs column is. */
  :global(.playground-page) { background: var(--color-ground) }
  /* The tool and its left column are `section` elements, and a documentation page puts a
     section gap in front of every section it holds, so a page that embeds the tool would get
     that gap twice over and inside the grid. The component owns its own spacing. */
  .ts-playground { margin: 0; border: 1px solid var(--color-line-1); border-radius: var(--radius-md); overflow: hidden; background: var(--color-surface-1); }
  .playground-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 14px; border-bottom: 1px solid var(--color-line-1); background: var(--color-ground); }
  .playground-toolbar strong { font: 500 .8125rem/1.4 var(--font-mono); }
  .playground-actions { display: flex; gap: 8px; }
  .playground-actions button { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 7px 11px; background: var(--color-ground); color: var(--color-text-1); font: 500 .75rem/1.3 var(--font-sans); white-space: nowrap; cursor: pointer; }
  .playground-actions button:hover { background: var(--color-surface-1); }
  .playground-actions .primary { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-ground); }
  .playground-actions .primary:hover { background: var(--color-accent); filter: brightness(0.92); }
  /* One row: the file, the picker and its blurb read left to right, so the toolbar is a
     toolbar and not a card. The blurb wraps inside its own space when it has to. */
  .playground-pick { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; min-width: 0; }
  .playground-pick .pick-row { display: flex; align-items: center; gap: 8px; }
  .playground-pick label { color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  .playground-pick select { max-width: 100%; border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 5px 8px; background: var(--color-ground); color: var(--color-text-1); font: 500 .75rem/1.3 var(--font-sans); }
  .playground-pick [data-example-note] { flex: 1 1 24ch; min-width: 0; max-width: 52ch; margin: 0; color: var(--color-text-3); font-size: .75rem; line-height: 1.45; }

  .playground-options { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; padding: 8px 14px 10px; border-bottom: 1px solid var(--color-line-1); background: var(--color-ground); }
  .playground-options label { display: block; margin-bottom: 4px; color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  .playground-options select { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 6px 9px; background: var(--color-ground); color: var(--color-text-1); font: 400 .75rem/1.3 var(--font-mono); }
  .playground-check { display: flex; align-items: center; gap: 6px; padding-bottom: 7px; }
  .playground-check label { margin-bottom: 0; }
  .playground-check input { accent-color: var(--color-accent); }
  .playground-options [data-level-note], .playground-options [data-prelude-note] { flex-basis: 100%; margin: 0; color: var(--color-text-3); font-size: .75rem; line-height: 1.5; }
  .playground-options :global(code) { font: 400 .75rem/1.5 var(--font-mono); }

  .output-meta { display: flex; flex: none; align-items: center; gap: 10px; }
  .output-meta [data-size] { color: var(--color-text-3); font: 400 .6875rem/1.3 var(--font-mono); }
  .output-meta button { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 3px 8px; background: var(--color-ground); color: var(--color-text-2); font: 500 .6875rem/1.3 var(--font-sans); cursor: pointer; }
  .output-meta button:hover { color: var(--color-text-1); }
  .output-tabs button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }

  /* The source and the result are the two things a reader looks between, so they sit side
     by side and end on the same line. The left column is the editor over its diagnostics;
     the right one is a single tab strip over a single panel, so the reader trades the
     canvas for the emitted text in place instead of scrolling between stacked panes. The
     column widths follow the tool's own box and not the window's, since the Playground is
     on a page of its own and inside a documentation column on every example page. */
  .ts-playground { container-type: inline-size; }
  .playground-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .pane { margin: 0; min-width: 0; }
  .source-pane { display: flex; flex-direction: column; border-bottom: 1px solid var(--color-line-1); }
  .result-column { display: flex; flex-direction: column; min-width: 0; }
  /* One panel is shown and the rest carry `hidden`. The panels are flex and grid boxes, so
     the attribute is spelled out here; `display` from a class would otherwise win. */
  .result-panels { display: flex; flex: 1 1 auto; flex-direction: column; min-height: 0; }
  .result-panels > [hidden] { display: none; }
  /* The tabs and the controls the selected tab owns share one row while both fit; where
     they do not, the controls take a row under the tabs instead of cutting a tab label in
     half. The tablist's basis is what decides which of the two happens. */
  .result-head { flex-wrap: wrap; gap: 8px; }
  .result-head .output-tabs { flex: 1 1 21rem; overflow-x: auto; scrollbar-width: none; }
  .result-head .output-tabs::-webkit-scrollbar { display: none; }
  .result-head > [data-meta] { margin-inline-start: auto; }
  .pane-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 12px; color: var(--color-text-2); font-size: .75rem; font-weight: 500; background: var(--color-surface-2); }
  .pane-title kbd { color: var(--color-text-3); font: 500 .6875rem/1.3 var(--font-mono); }
  .editor-host, pre { box-sizing: border-box; width: 100%; margin: 0; border: 0; border-radius: 0; background: var(--color-ground); color: var(--color-text-1); font: 400 .8125rem/1.65 var(--font-mono); }
  /* Flex bases of 0 so neither pane's content sets the row height: the editor and the output
     take the room the row has and scroll inside it. The editor's floor is what sets the row
     beside it, since the result column is one panel now and no longer two stacked ones. */
  .editor-host { flex: 1 1 0; min-height: 420px; overflow: hidden; }
  pre { flex: 1 1 0; min-height: 320px; padding: 16px; overflow: auto; white-space: pre; }
  /* Under the editor, since that is where a reader looks when the source is wrong, and with
     the compile status beside its title, so one row says how the last compile went. */
  .diagnostics { min-height: 88px; padding: 10px 16px 12px; border-top: 1px solid var(--color-line-1); background: var(--color-surface-1); }
  .diagnostics-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  .diagnostics-title [data-status] { color: var(--color-text-3); font: 500 .6875rem/1.3 var(--font-mono); letter-spacing: 0; }
  [data-diagnostics] { margin: 0; padding: 0; list-style: none; color: var(--color-text-2); font: 400 .75rem/1.55 var(--font-mono); }
  /* The rows are built by the script after the page loads, so they carry no scoping attribute
     and a plain descendant selector would miss them, the way .reflection's contents do. */
  [data-diagnostics] :global(li + li) { margin-top: 2px; }
  [data-diagnostics] :global(button) { display: block; width: 100%; border: 0; border-radius: var(--radius-sm); padding: 2px 4px; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  [data-diagnostics] :global(button:hover) { background: var(--color-surface-2); }
  [data-diagnostics] :global(.at) { color: var(--color-text-3); }
  /* Which half of the pipeline raised the row: TypeScript over the ambient lib, or the TypeShade front end. */
  [data-diagnostics] :global(.source) { color: var(--color-text-3); font-weight: 600; }
  [data-diagnostics] :global(.error) { color: var(--color-diag); }
  .has-errors [data-status] { color: var(--color-diag); }
  .has-errors .diagnostics { border-top-color: var(--color-diag); }
  .has-output [data-status] { color: var(--color-accent); }
  .output-tabs { display: flex; gap: 2px; margin: -3px 0; }
  .output-tabs button { flex: none; border: 0; border-radius: var(--radius-sm); padding: 3px 8px; background: transparent; color: var(--color-text-3); font: 500 .75rem/1.4 var(--font-sans); white-space: nowrap; cursor: pointer; }
  .output-tabs button:hover { color: var(--color-text-1); }
  .output-tabs button[aria-selected='true'] { background: var(--color-ground); color: var(--color-text-1); }
  .reflect-meta { display: flex; flex: none; align-items: center; }
  .reflect-meta button { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 4px 9px; background: var(--color-ground); color: var(--color-text-1); font: 500 .6875rem/1.3 var(--font-sans); cursor: pointer; }
  .reflect-meta button:hover:not(:disabled) { background: var(--color-surface-1); }
  .reflect-meta button:disabled { opacity: .5; cursor: default; }
  /* The pane's contents are built by src/scripts/playground.ts after the page loads, so those
     nodes never carry Astro's scoping attribute and a plain descendant selector would miss
     them. The scoped parent is .reflection; everything under it is addressed globally. */
  .canvas-meta { display: flex; flex: none; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px; }
  .canvas-meta label { color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  .canvas-meta select { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 3px 6px; background: var(--color-ground); color: var(--color-text-1); font: 400 .6875rem/1.3 var(--font-mono); }
  .canvas-meta button { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 4px 9px; background: var(--color-ground); color: var(--color-text-1); font: 500 .6875rem/1.3 var(--font-sans); cursor: pointer; }
  .canvas-meta button:hover:not(:disabled) { background: var(--color-surface-1); }
  .canvas-meta button:disabled { opacity: .5; cursor: default; }
  /* The canvas panel takes the room the row has and holds the canvas at the top of it, so
     the box the picture is drawn in is the same size behind every tab. */
  .canvas-host { display: flex; flex: 1 1 auto; flex-direction: column; align-items: stretch; gap: 8px; padding: 14px 16px 12px; background: var(--color-ground); }
  .canvas-host [data-canvas-note], .canvas-host [data-gpu-note] { align-self: center; margin: 0; min-height: 1.3em; max-width: 60ch; color: var(--color-text-2); font: 400 .6875rem/1.45 var(--font-mono); text-align: center; }
  .canvas-host [hidden] { display: none; }
  /* The picture takes the width of its column at 4:3, the way a Shadertoy pane does, and
     every engine draws into the same box. The runtime matches a GPU canvas's drawing buffer
     to the box; the rasteriser's grid is its own, shown at the box's size. */
