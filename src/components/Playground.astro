---
import { copyFor, type Locale } from '../i18n/index.ts'
import { defaultPlaygroundExample, playgroundExamples } from '../lib/playground-examples.ts'

interface Props { locale: Locale }
const { locale } = Astro.props
const t = copyFor(locale).playground

// The examples arrive from the vendored checkout at build time: the source text from the
// file, the title and the description from this locale's dictionary. `_shade.ts` reads the
// filesystem, so the browser half never imports it.
const examples = playgroundExamples().map((example) => ({
  id: example.id,
  source: example.source,
  title: t.examples[example.id].title,
  description: t.examples[example.id].description,
}))

/** The output tabs, in the order the tablist shows them. */
const tabs = [
  { id: 'wgsl', label: t.tabs.wgsl },
  { id: 'glsl-vertex', label: t.tabs.glslVertex },
  { id: 'glsl-fragment', label: t.tabs.glslFragment },
  { id: 'reflection', label: t.tabs.reflection },
  { id: 'run', label: t.tabs.run },
]

// The words the browser half needs once it is running. It reads them off the element, since
// the script that holds the logic is a bundled module and takes no `define:vars`.
const runtimeCopy = {
  fileName: t.fileName,
  idle: t.idle,
  ready: t.ready,
  errors: t.errors,
  loading: t.loading,
  clean: t.clean,
  directive: t.directive,
  unavailable: t.unavailable,
  copy: t.copy,
  copied: t.copied,
  empty: t.empty,
  reflection: {
    entries: t.reflection.entries,
    stage: t.reflection.stage,
    name: t.reflection.name,
    inputs: t.reflection.inputs,
    outputs: t.reflection.outputs,
    workgroup: t.reflection.workgroup,
    bindings: t.reflection.bindings,
    group: t.reflection.group,
    binding: t.reflection.binding,
    space: t.reflection.space,
    kind: t.reflection.kind,
    uniforms: t.reflection.uniforms,
    storage: t.reflection.storage,
    field: t.reflection.field,
    type: t.reflection.type,
    offset: t.reflection.offset,
    size: t.reflection.size,
    features: t.reflection.features,
    none: t.reflection.none,
  },
  runner: t.runner,
}
---

<section
  class="ts-playground"
  data-playground
  data-examples={JSON.stringify(examples)}
  data-default-example={defaultPlaygroundExample}
  data-copy={JSON.stringify(runtimeCopy)}
>
  <div class="playground-toolbar">
    <div class="playground-pick">
      <label for="playground-example">{t.exampleLabel}</label>
      <select id="playground-example" data-example>
        {examples.map((example) => <option value={example.id}>{example.title}</option>)}
      </select>
      <p data-example-note>{examples[0]?.description}</p>
    </div>
    <div class="playground-actions">
      <button type="button" data-reset>{t.reset}</button>
      <button type="button" class="primary" data-run>{t.run}</button>
    </div>
  </div>

  <div class="playground-grid">
    <section class="pane source-pane">
      <div class="pane-title"><span>{t.editor}</span><span data-status>{t.idle}</span></div>
      <div class="editor-host" data-editor aria-label={t.editor}></div>
    </section>

    <section class="pane output-pane">
      <div class="pane-tabs" role="tablist" aria-label={t.output}>
        {tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`pg-tab-${tab.id}`}
            aria-controls={`pg-panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={tab.id}
          >{tab.label}</button>
        ))}
      </div>

      {tabs.map((tab, i) => (
        <div
          class="tab-panel"
          role="tabpanel"
          id={`pg-panel-${tab.id}`}
          aria-labelledby={`pg-tab-${tab.id}`}
          tabindex="0"
          data-panel={tab.id}
          hidden={i !== 0}
        >
          <div class="panel-bar">
            <button type="button" data-copy-panel={tab.id}>{t.copy}</button>
          </div>
          {tab.id === 'run' && (
            <div class="run-form">
              <label for="playground-entry">{t.runner.entry}</label>
              <select id="playground-entry" data-entry></select>
              <div class="run-args" data-args></div>
              <button type="button" class="primary" data-run-entry>{t.runner.execute}</button>
            </div>
          )}
          {tab.id === 'reflection'
            ? <div class="reflection" data-body={tab.id}></div>
            : <pre data-body={tab.id} data-output={tab.id === 'wgsl' ? '' : undefined}></pre>}
          <p class="panel-empty" data-empty={tab.id}></p>
        </div>
      ))}
    </section>
  </div>

  <div class="diagnostics">
    <div class="diagnostics-title">{t.diagnostics}</div>
    <ul data-diagnostics aria-live="polite"></ul>
  </div>
</section>

<script>
  import '../scripts/playground.ts'
</script>

<style>
  .ts-playground { border: 1px solid var(--color-line-1); border-radius: var(--radius-md); overflow: hidden; background: var(--color-surface-1); }
  .playground-toolbar { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; padding: 12px 14px; border-bottom: 1px solid var(--color-line-1); background: var(--color-ground); }
  .playground-pick { min-width: 0; }
  .playground-pick label { display: block; margin-bottom: 4px; color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  .playground-pick select { max-width: 100%; border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 6px 9px; background: var(--color-ground); color: var(--color-text-1); font: 500 .8125rem/1.3 var(--font-sans); }
  .playground-pick p { margin: 6px 0 0; max-width: 46ch; color: var(--color-text-3); font-size: .75rem; line-height: 1.5; }
  .playground-actions { display: flex; flex: none; gap: 8px; }
  .playground-actions button, .run-form button { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 7px 11px; background: var(--color-ground); color: var(--color-text-1); font: 500 .75rem/1.3 var(--font-sans); cursor: pointer; }
  .playground-actions button:hover, .run-form button:hover { background: var(--color-surface-1); }
  .playground-actions .primary, .run-form .primary { border-color: var(--color-accent); background: var(--color-accent); color: white; }
  .playground-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .pane { display: flex; flex-direction: column; min-width: 0; }
  .source-pane { border-bottom: 1px solid var(--color-line-1); }
  .pane-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 12px; color: var(--color-text-2); font-size: .75rem; font-weight: 500; background: var(--color-surface-2); }
  .pane-title [data-status] { color: var(--color-text-3); font: 500 .6875rem/1.3 var(--font-mono); }

  .pane-tabs { display: flex; overflow-x: auto; background: var(--color-surface-2); }
  .pane-tabs button { flex: none; border: 0; border-bottom: 2px solid transparent; padding: 9px 12px; background: none; color: var(--color-text-3); font: 500 .75rem/1.3 var(--font-sans); white-space: nowrap; cursor: pointer; }
  .pane-tabs button:hover { color: var(--color-text-1); }
  .pane-tabs button[aria-selected='true'] { border-bottom-color: var(--color-accent); color: var(--color-text-1); background: var(--color-ground); }
  .pane-tabs button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }

  .tab-panel { position: relative; display: flex; flex: 1; flex-direction: column; min-height: 480px; background: var(--color-ground); }
  .tab-panel:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .panel-bar { position: absolute; top: 8px; right: 12px; z-index: 1; }
  .panel-bar button { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 4px 8px; background: var(--color-ground); color: var(--color-text-2); font: 500 .6875rem/1.3 var(--font-sans); cursor: pointer; }
  .panel-bar button:hover { color: var(--color-text-1); }
  .tab-panel pre { box-sizing: border-box; width: 100%; margin: 0; padding: 16px; overflow: auto; color: var(--color-text-1); font: 400 .8125rem/1.65 var(--font-mono); white-space: pre; }
  .panel-empty { margin: 0; padding: 16px 16px 20px; color: var(--color-text-3); font-size: .8125rem; line-height: 1.6; }
  .panel-empty:empty { display: none; }

  .reflection { padding: 12px 16px 20px; overflow-x: auto; }
  .reflection h3 { margin: 14px 0 6px; color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  .reflection h3:first-child { margin-top: 0; }
  .reflection table { width: 100%; border-collapse: collapse; font: 400 .75rem/1.6 var(--font-mono); }
  .reflection th, .reflection td { padding: 4px 10px 4px 0; text-align: left; vertical-align: top; white-space: nowrap; }
  .reflection th { color: var(--color-text-3); font-weight: 500; }
  .reflection td { color: var(--color-text-1); }
  .reflection p { margin: 0; color: var(--color-text-3); font-size: .75rem; }

  .run-form { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--color-line-1); }
  .run-form label { display: block; margin-bottom: 4px; color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  .run-form select, .run-args input { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 6px 9px; background: var(--color-ground); color: var(--color-text-1); font: 400 .75rem/1.3 var(--font-mono); }
  .run-args { display: flex; flex-wrap: wrap; gap: 10px; }
  .run-args input { width: 11ch; }
  .run-args .wide input { width: 18ch; }

  .editor-host { box-sizing: border-box; width: 100%; min-height: 480px; overflow: hidden; background: var(--color-ground); }
  .diagnostics { min-height: 96px; padding: 12px 16px; border-top: 1px solid var(--color-line-1); background: var(--color-surface-1); }
  .diagnostics-title { margin-bottom: 6px; color: var(--color-text-3); font-size: .6875rem; font-weight: 600; letter-spacing: .06em; }
  [data-diagnostics] { margin: 0; padding: 0; list-style: none; color: var(--color-text-2); font: 400 .75rem/1.55 var(--font-mono); }
  [data-diagnostics] li + li { margin-top: 2px; }
  [data-diagnostics] button { display: block; width: 100%; border: 0; border-radius: var(--radius-sm); padding: 2px 4px; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  [data-diagnostics] button:hover { background: var(--color-surface-2); }
  [data-diagnostics] .at { color: var(--color-text-3); }
  [data-diagnostics] .error { color: var(--color-diag); }
  .has-errors [data-status] { color: var(--color-diag); }
  .has-errors .diagnostics { border-top-color: var(--color-diag); }
  .has-output [data-status] { color: var(--color-accent); }

  @media (min-width: 64rem) { .playground-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .source-pane { border-bottom: 0; border-right: 1px solid var(--color-line-1); } }
  @media (max-width: 48rem) {
    .playground-toolbar { align-items: stretch; flex-direction: column; }
    .playground-actions { width: 100%; }
    .playground-actions button { flex: 1; }
    .editor-host, .tab-panel { min-height: 320px; }
    .run-form { flex-direction: column; align-items: stretch; }
  }
</style>
