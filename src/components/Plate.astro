---
// PLATE — design §5 "Plate and scroll region". One shape, several proofs: a `surface-2`
// ground, a 1 px `line-1` frame, an optional 32 px bezel (`micro/code` left, an optional slot
// right) and a body. Bezel and body are separated by a hairline, never a gap, and the bezel
// grows to two rows rather than truncating.
interface Props {
  /** The bezel's `micro/code` label. Omit for a plate with no bezel. */
  label?: string
  /** `micro/word` (uppercase, tracked) instead of `micro/code` — for a label with no
   *  identifier, file name or version in it (§3 forbids uppercasing those). */
  labelWord?: boolean
  /** Drop the body's 16 px padding: a plate whose whole body is one row that pads itself. */
  flush?: boolean
  class?: string
}
const { label, labelWord = false, flush = false, class: className } = Astro.props
---

<div class:list={['plate', className]}>
  {
    label && (
      <div class:list={['plate-bezel', labelWord && 'micro-word']}>
        <span>{label}</span>
        <slot name="bezel-end" />
      </div>
    )
  }
  <div class:list={[!flush && 'plate-body']}>
    <slot />
  </div>
</div>

<style>
  /* `.plate-bezel` is already mono/micro; the word variant only swaps the face and tracking,
     so it is applied ON the bezel rather than nested inside it. */
  .plate-bezel.micro-word {
    font-family: var(--font-sans);
  }
</style>
