---
// CANVAS FIGURE — design §5 "Canvas mount (specimen)". The page-facing specimen: a bezel
// carrying its label and the state marker, the 8 px `--color-ground` mat, the canvas at its
// declared aspect, and the caption plate.
//
// It renders through `ShaderCanvas`, which owns the parts that must have exactly one
// authority: the build-time payload and its D-8 dedup, the per-state strings, the derived
// accessible name, and the single tick in which caption + header + `aria-label` are written
// from `canvas.dataset.backend` (I-2). This component owns what the PAGE decides — which
// example, still or live, which backend is forced, the box, and the copy of record.
//
// The 8 px mat is the whole reason `--color-line-2` can be the frame token: M-9 measures that
// rule at 1.52:1 against `gradient`'s own brightest pixel, so a frame that touched the image
// would have no floor at all. With the mat both of the rule's neighbours are the page ground —
// 3.39:1 at every mount, every frame and every backend, by construction.
import ShaderCanvas from './ShaderCanvas.astro'
import type { CanvasText } from './ShaderCanvas.astro'

interface Props {
  example: string
  /** One frame at the pinned clock, then stop (R-9). Four of the page's five mounts. */
  still?: boolean
  /** Skip the WebGPU probe — §agree's GLSL ES 3.00 half (R-8). */
  forceWebGl2?: boolean
  /** deck §6's caption columns for THIS mount. */
  caption: CanvasText
  /** The bezel. A plain string is a label that names no backend and therefore reads the same
   *  in every state (§precision's legend, §write's example id); a `CanvasText` is a header
   *  that names one, and is rewritten from `data-backend` like the caption beside it. */
  header: CanvasText | string
  /** The box, inside the mat. `B1.CANVAS` 4/3 · the §agree pair 16/9 · `B4.CANVAS` 3/2 —
   *  carried at every width, because the box must exist before the canvas paints. */
  aspect: '4/3' | '16/9' | '3/2'
  /** §precision's split bezel (design §5): the LEFT half's label, `header` being the right
   *  half's. Passing it splits the bezel at `--b4-split` and draws the rule and crop marks. */
  splitLabel?: string
  class?: string
}
const {
  example,
  still = false,
  forceWebGl2 = false,
  caption,
  header,
  aspect,
  splitLabel,
  class: className,
} = Astro.props

// A label with no backend in it is still expanded to the five states, so the runtime's one
// write path stays the only path: a static bezel simply says the same thing in each.
const headerText: CanvasText =
  typeof header === 'string'
    ? { neutral: header, webgpu: header, webgl2: header, none: header }
    : header
---

<ShaderCanvas
  example={example}
  still={still}
  forceWebGl2={forceWebGl2}
  caption={caption}
  header={headerText}
  splitLabel={splitLabel}
  class:list={[
    'w-full',
    aspect === '4/3' ? 'aspect-[4/3]' : aspect === '16/9' ? 'aspect-[16/9]' : 'aspect-[3/2]',
    className,
  ]}
/>
