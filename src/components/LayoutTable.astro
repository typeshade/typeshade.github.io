---
// The uniform block of the fixture, every cell from reflect(). The table sits at its natural
// width, with the caption naming the standard and the block size.
import { facts } from '../lib/examples.ts'
import { typedError } from '../lib/typed-error.ts'
import ScrollRegion from './ScrollRegion.astro'

const { layout } = typedError()
if (layout.fields.length < 2) throw new Error('[LayoutTable] the fixture block reflects fewer than two fields')
const standard = facts.layoutStandards[0]
---

<ScrollRegion label={`Reflected ${standard} layout`}>
  <table class="layout-table">
    <caption>reflect(), {standard}, {layout.size} bytes</caption>
    <thead>
      <tr>
        <th scope="col">field</th>
        <th scope="col">type</th>
        <th scope="col" data-align="end">offset</th>
        <th scope="col" data-align="end">size</th>
      </tr>
    </thead>
    <tbody>
      {
        layout.fields.map((f) => (
          <tr>
            <td>{f.name}</td>
            <td>{f.type}</td>
            <td data-align="end">{f.offset}</td>
            <td data-align="end">{f.size}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</ScrollRegion>
