---
// One entry of the language reference: the name, the compiler's sentence about it, the
// declaration the editor loads for it, and, for a builtin function, what each backend
// writes. The data is a LanguageEntry (src/lib/language-reference.ts), generated from the
// compiler's own language service; the words around it are docs.reference in every
// dictionary. The heading level is the page's, since the functions page runs its entries
// under a family heading and the other five run them at the top level.
//
// CSS: src/styles/global.css, under "The language reference". The classes are .ref-entry,
// .ref-entry-name, .ref-entry-summary, .ref-entry-meta, .ref-label and .ref-emits.
import { Code } from 'astro-expressive-code/components'
import Rich from './Rich.astro'
import type { LanguageEntry } from '../lib/language-reference.ts'
import { copyFor, localePath, type Locale } from '../i18n/index.ts'
import { links } from '../lib/links.ts'

interface Props {
  locale: Locale
  entry: LanguageEntry
  /** 2 on a page whose entries sit at the top level, 3 under a family heading. */
  level: 2 | 3
}
const { locale, entry, level } = Astro.props
const r = copyFor(locale).docs.reference
const Name = level === 2 ? 'h2' : 'h3'
// Where the builtin table shows the same call, four columns wide.
const tableHref = entry.spelling
  ? `${localePath(locale, links.languageBuiltins.href)}#${entry.spelling.family}`
  : undefined
const stageText = entry.stages.map((s) => r.stageRule(r.stages[s.stage as keyof typeof r.stages] ?? s.stage, r.directions[s.direction as keyof typeof r.directions] ?? s.direction))
// What a target cell shows when the registry has no spelling: the copy for an id a pre-emit
// pass consumes, the registry's own message where it named a reason, and the plain "no form"
// line otherwise. The compiler's message is English on every locale, the way the sentence
// above it is.
type Cell = { readonly code: string } | { readonly copy: string } | { readonly message: string }
const cellFor = (text: string | null, message: string): Cell => {
  if (text !== null) return { code: text }
  if (entry.spelling?.preEmit) return { copy: r.preEmit }
  return message.length > 0 ? { message } : { copy: r.noForm }
}
const wgslCell = entry.spelling ? cellFor(entry.spelling.wgsl, '') : null
const glslCell = entry.spelling ? cellFor(entry.spelling.glsl, entry.spelling.glslMessage) : null
---

<div class="ref-entry">
  <Name class="ref-entry-name" id={entry.name}><code>{entry.title}</code></Name>
  <p class="ref-entry-summary" lang="en"><Rich text={entry.summary} locale={locale} /></p>
  {entry.kind === 'builtin' ? (
    <p class="ref-entry-code"><code>{entry.signature}</code></p>
  ) : (
    <Code code={entry.signature} lang="ts" locale={locale} wrap />
  )}
  {entry.kind === 'builtin' && (
    <p class="ref-entry-meta" lang={locale}>
      {stageText.length > 0 ? <><span class="ref-label">{r.validIn}</span> {stageText.join(', ')}</> : r.anyStage}
    </p>
  )}
  {wgslCell && glslCell && (
    <dl class="ref-emits">
      <dt lang={locale}>{r.wgsl}</dt>
      <dd>
        {'code' in wgslCell && <code>{wgslCell.code}</code>}
        {'copy' in wgslCell && <span lang={locale}><Rich text={wgslCell.copy} locale={locale} /></span>}
        {'message' in wgslCell && <span lang="en">{wgslCell.message}</span>}
      </dd>
      <dt lang={locale}>{r.glsl}</dt>
      <dd>
        {'code' in glslCell && <code>{glslCell.code}</code>}
        {'copy' in glslCell && <span lang={locale}><Rich text={glslCell.copy} locale={locale} /></span>}
        {'message' in glslCell && <span lang="en">{glslCell.message}</span>}
      </dd>
    </dl>
  )}
  {tableHref && (
    <p class="ref-entry-meta" lang={locale}><a href={tableHref}>{r.inTable}</a></p>
  )}
</div>
