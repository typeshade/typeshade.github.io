---
// One live example: the source a reader can edit, the canvas it draws on, and a control for
// every uniform field the module declares.
//
// The build compiles the sample here (src/lib/live-shader-emit.ts) and inlines what the page
// needs as JSON: the emitted WGSL and GLSL ES 3.00 stages, the reflected layout, and the
// controls the reflection asks for. The compiler itself stays out of the page until the
// reader's first edit, when src/scripts/live-shader.ts imports it as a chunk of its own.
//
// Putting one on a page: see "Live examples" in DESIGN.md.
import { Code } from 'astro-expressive-code/components'
import Rich from './Rich.astro'
import { copyFor, type Locale } from '../i18n/index.ts'
import { liveShader, livePayloadJson } from '../lib/live-shader-emit.ts'
import type { ControlProps } from '../lib/live-shader-contract.ts'
import type { StateStrings } from '../lib/shader-runtime.ts'

interface Props {
  locale: Locale
  /** Names the example. It is the id of its still image and of its inlined payload, so it is
   *  unique across the site. */
  id: string
  /** What the canvas is showing, for the accessible name. From the dictionaries. */
  title: string
  /** The sample: a whole file, the way a Book of Shaders page shows a whole `.frag`. A
   *  sample that declares no `@vertex` entry is compiled behind the fullscreen-triangle
   *  vertex half (src/lib/live-shader-contract.ts) and takes `uv` as a `@location(0)`
   *  parameter; one that declares both stages is compiled as written. Code is not copy, so it
   *  stays on the page that uses it. */
  code: string
  /** The line under the canvas. From the dictionaries. */
  caption: string
  /** The name over the block. A file name is not copy, so it is written here and reads the
   *  same in every language, the way the other code frames on the site name their file. */
  file?: string
  /** Range, step, default and label for one uniform field each. A field the module does not
   *  declare fails the build. */
  controls?: ControlProps
  aspect?: '3/1' | '2/1' | '16/9' | '3/2'
}

const { locale, id, title, code, caption, file, controls = {}, aspect = '2/1' } = Astro.props
const t = copyFor(locale)
const l = t.live
const payload = liveShader(id, title, code, controls)
const aria: StateStrings = t.canvas.aria(title)

// The words the browser half needs once it is running. It reads them off the element: the
// module that holds the logic is bundled and takes no `define:vars`.
const runtimeCopy = {
  editorAria: l.editorAria,
  hint: l.hint,
  compiling: l.compiling,
  loading: l.loading,
  clean: l.clean,
  keptFrame: l.keptFrame,
  controls: l.controls,
  reset: l.reset,
  backend: { webgpu: l.backend.webgpu, webgl2: l.backend.webgl2, none: l.backend.none },
  aria,
  lineAt: l.lineAt,
  component: l.component,
}

const payloadId = `live-payload-${id}`
const fields = payload.data.layout.fields
// The note under the controls names the reserved fields this sample actually declares, so it
// describes the file above it. The names go in as code spans, which Rich renders.
const reservedNote = l.reserved(payload.reserved.map((name) => `\`${name}\``).join(', '))
---

<figure
  class="live"
  data-live-shader
  data-live-id={id}
  data-payload={payloadId}
  data-copy={JSON.stringify(runtimeCopy)}
  data-live-state="idle"
>
  <div class="live-code" data-live-code>
    <Code code={payload.source} lang="ts" title={file ?? l.file} locale={locale} />
  </div>

  <div class="live-bar">
    <button type="button" data-live-edit>{l.edit}</button>
    <span class="live-hint">{l.hint}</span>
    <button type="button" data-live-reset>{l.reset}</button>
  </div>

  <div class="figure-frame live-frame" style={`aspect-ratio: ${aspect}`}>
    <img src={`/stills/${id}.webp`} alt={aria.none} loading="lazy" decoding="async" />
    <canvas role="img" aria-label={aria.none} data-backend="none"></canvas>
  </div>
  <figcaption class="figure-caption">{caption}</figcaption>
  <p class="live-backend" data-live-status>{l.backend.neutral}</p>

  <div class="live-diagnostics" data-live-diagnostics aria-live="polite"></div>

  <div class="live-panel">
    <div class="live-panel-title">{l.controls}</div>
    <div class="live-controls" data-live-controls hidden></div>
    {payload.reserved.length > 0 && (
      <p class="live-reserved">
        <Rich text={reservedNote} locale={locale} />
        {payload.reserved.includes('mouse') && <Fragment> <Rich text={l.mouseUnits} locale={locale} /></Fragment>}
      </p>
    )}
  </div>

  <details class="live-output">
    <summary>{l.output}</summary>
    <div class="live-output-body">
      <div data-live-emitted="wgsl"><Code code={payload.wgsl} lang="wgsl" title={l.wgsl} locale={locale} /></div>
      <div data-live-emitted="vertex"><Code code={payload.glsl.vertex} lang="glsl" title={l.glslVertex} locale={locale} /></div>
      <div data-live-emitted="fragment"><Code code={payload.glsl.fragment} lang="glsl" title={l.glslFragment} locale={locale} /></div>
      <div class="live-reflection">
        <div class="live-panel-title">{l.uniforms}</div>
        {fields.length === 0 ? (
          <p class="live-reserved">{l.noUniforms}</p>
        ) : (
          <table>
            <thead><tr><th>{l.field}</th><th>{l.type}</th><th>{l.offset}</th></tr></thead>
            <tbody>
              {fields.map((f) => (
                <tr><td><code>{f.name}</code></td><td><code>{f.type}</code></td><td><code>{f.offset}</code></td></tr>
              ))}
            </tbody>
          </table>
        )}
        <div class="live-panel-title">{l.entries}</div>
        <p class="live-entries">{payload.entries.map((e) => <code>{`@${e.stage} ${e.name}`}</code>)}</p>
      </div>
    </div>
  </details>

  <script type="application/json" id={payloadId} set:html={livePayloadJson(payload)} is:inline />
</figure>

<script>
  import '../scripts/live-shader.ts'
</script>

<style>
  .live { margin: 0 0 var(--space-8, 2rem); }
  .live-code { position: relative; }
  .live-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 8px; }
  .live-bar button { border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 5px 10px; background: var(--color-ground); color: var(--color-text-1); font: 500 .75rem/1.3 var(--font-sans); cursor: pointer; }
  .live-bar button:hover { background: var(--color-surface-1); }
    /* On a phone the hint takes a line of its own under the two buttons, so neither is cut off. */
  .live-hint { flex: 1 1 100%; order: 3; min-width: 0; color: var(--color-text-3); font-size: .75rem; }
  .live-frame { margin-top: 12px; }
  .live-backend { margin: 4px 0 0; color: var(--color-text-3); font-size: .75rem; }
  .live-diagnostics { margin-top: 10px; font: 400 .75rem/1.6 var(--font-mono); color: var(--color-text-2); }
  .live-panel { margin-top: 16px; }
  .live-panel-title { margin-bottom: 8px; color: var(--color-text-3); font: 600 .6875rem/1.3 var(--font-sans); letter-spacing: .06em; }
  .live-output-body .live-panel-title { margin-top: 16px; }
  .live-reserved { margin: 8px 0 0; color: var(--color-text-3); font-size: .75rem; }
  .live-entries { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; font-size: .75rem; }
  .live-output { margin-top: 16px; border-top: 1px solid var(--color-line-1); padding-top: 10px; }
  .live-output summary { color: var(--color-text-2); font-size: .8125rem; cursor: pointer; }
  .live-reflection table { width: 100%; border-collapse: collapse; font-size: .75rem; }
  .live-reflection th, .live-reflection td { padding: 4px 8px 4px 0; text-align: left; border-bottom: 1px solid var(--color-line-1); }

  /* The textarea and the control rows are built by src/scripts/live-shader.ts after the page
     loads, so those nodes carry no scoping attribute and are addressed globally. */
  .live-code :global(.live-input) {
    position: absolute; inset: 0; z-index: 1; box-sizing: border-box; width: 100%;
    margin: 0; border: 0; outline-offset: -2px; resize: none; overflow: auto;
    background: transparent; color: transparent; caret-color: var(--color-accent);
    -webkit-text-fill-color: transparent; white-space: pre; tab-size: 2;
  }
  .live-code :global(.live-input::selection) { background: color-mix(in srgb, var(--color-accent) 28%, transparent); }
  .live-controls[hidden] { display: none; }
  .live-controls :global(.live-control) { display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 6px 0; border-top: 1px solid var(--color-line-1); }
  .live-controls :global(.live-control-head) { display: flex; align-items: baseline; gap: 8px; font-size: .75rem; }
  .live-controls :global(.live-control-head code) { font-size: .75rem; }
  .live-controls :global(.live-control-label) { flex: 1; min-width: 0; color: var(--color-text-3); }
  .live-controls :global(.live-control-value) { color: var(--color-text-3); font: 400 .6875rem/1.4 var(--font-mono); }
  .live-controls :global(.live-control-inputs) { display: flex; flex-wrap: wrap; gap: 8px; }
  .live-controls :global(.live-control-inputs input[type='range']) { flex: 1 1 140px; min-width: 0; accent-color: var(--color-accent); }
  .live-controls :global(.live-control-inputs input[type='number']) { width: 6rem; border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); padding: 3px 6px; background: var(--color-ground); color: var(--color-text-1); font: 400 .75rem/1.4 var(--font-mono); }
  .live-controls :global(input[type='checkbox']) { width: 16px; height: 16px; accent-color: var(--color-accent); }
  .live-controls :global(input[type='color']) { width: 48px; height: 24px; padding: 0; border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); background: var(--color-ground); }
  .live-controls :global(.live-pad) { position: relative; width: 112px; height: 112px; border: 1px solid var(--color-line-2); border-radius: var(--radius-sm); background: var(--color-surface-1); touch-action: none; cursor: crosshair; }
  .live-controls :global(.live-pad-dot) { position: absolute; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--color-accent); }
  .live-diagnostics :global(.live-clean) { color: var(--color-text-3); }
  .live-diagnostics :global(.live-message) { color: var(--color-diag); white-space: pre-wrap; }
  .live-diagnostics :global(.live-kept) { margin-top: 4px; color: var(--color-text-3); }
  .live[data-live-state='error'] .live-frame { border-color: var(--color-diag); }

  @media (min-width: 40rem) {
    .live-hint { flex: 1 1 auto; order: 0; }
    .live-controls :global(.live-control) { grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); align-items: center; gap: 12px; }
  }
</style>
