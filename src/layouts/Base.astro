---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import { facts } from '../lib/examples.ts'

interface Props {
  title?: string
  description?: string
}

const META = {
  title: 'TypeShade: typed shaders in TypeScript, emitted as WGSL and GLSL',
  description:
    'Write a shader once in TypeScript and emit WGSL for WebGPU and GLSL ES 3.00 for WebGL2. The same source runs on the CPU in double precision so the outputs can be checked.',
  ogTitle: 'TypeShade',
  ogAlt: 'TypeShade: one shader source for WebGPU and WebGL2, with a rendered metaballs shader.',
}
const { title = META.title, description = META.description } = Astro.props

const site = Astro.site ?? new URL('https://typeshade.dev/')
const canonical = new URL(Astro.url.pathname, site).toString()
const ogImage = new URL('/og.png', site).toString()

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.origin}/#website`, url: `${site.origin}/`, name: 'TypeShade', description: META.description, inLanguage: 'en' },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${site.origin}/#software`,
      name: 'TypeShade',
      description: META.description,
      programmingLanguage: ['TypeScript', 'WGSL', 'GLSL'],
      codeRepository: facts.mirrorUrl,
      license: 'https://opensource.org/licenses/MIT',
      url: `${site.origin}/`,
    },
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#1f6f43" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-sans-latin-wght-normal.woff2" crossorigin />
    <meta property="og:site_name" content="TypeShade" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={META.ogTitle} />
    <meta property="og:description" content={META.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={META.ogAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={META.ogTitle} />
    <meta name="twitter:description" content={META.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={META.ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
