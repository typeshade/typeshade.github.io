---
// The frame every page shares: head metadata, hreflang alternates, header and footer.
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { facts } from '../lib/examples.ts'
import { copyFor, defaultLocale, locales, localeUrl, type Locale } from '../i18n/index.ts'

interface Props {
  locale: Locale
  /** The locale-neutral route, for example '/checks'. */
  path: string
  title?: string
  description?: string
  /** A page that exists in one locale only (the 404) lists no alternates. */
  noAlternates?: boolean
}

const { locale, path, noAlternates = false } = Astro.props
const t = copyFor(locale)
const title = Astro.props.title ?? t.meta.title
const description = Astro.props.description ?? t.meta.description

const site = Astro.site ?? new URL('https://typeshade.dev/')
const canonical = localeUrl(site, locale, path)
const ogImage = new URL('/og.png', site).toString()
const alternates = noAlternates ? [] : locales.map((l) => ({ lang: l, href: localeUrl(site, l, path) }))

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.origin}/#website`, url: `${site.origin}/`, name: 'TypeShade', description: t.meta.description, inLanguage: locale },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${site.origin}/#software`,
      name: 'TypeShade',
      description: t.meta.description,
      programmingLanguage: ['TypeScript', 'WGSL', 'GLSL'],
      codeRepository: facts.mirrorUrl,
      license: 'https://opensource.org/licenses/MIT',
      url: `${site.origin}/`,
    },
  ],
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={localeUrl(site, defaultLocale, path)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/mask-icon.svg" color="#1f6f43" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-sans-latin-wght-normal.woff2" crossorigin />
    <meta property="og:site_name" content="TypeShade" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:title" content="TypeShade" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="TypeShade" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <SiteHeader locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} path={path} />
  </body>
</html>
