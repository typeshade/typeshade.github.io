---
// /og/ — the source of `public/og.png`, design §9.
//
// R-13: the OG card is a REAL captured hero frame, not a drawing. A drawn card on a page whose
// pitch is "this is real" would be its one dishonest pixel, so this route composites the same
// `metaballs` mount, the same three scrims and the same two headline spans the hero does, at
// 1200 x 630, and `scripts/capture-og.ts` photographs it on the reduced-motion pinned-clock
// path (one frame at t = 3 s, WebGPU asserted).
//
// It is `noindex` and excluded from the sitemap (astro.config.mjs), and the capture deletes
// `dist/og/` after shooting it, so the route is a build-time instrument and never a page.
//
// It does NOT use `Base.astro`: a card carries no nav, no skip link, no footer and no `main`.
// What it shares with the page it shares as a RECORD — the mark (`mark.ts`), the two headline
// pairs (`hero-copy.ts`), the mount's own copy (`heroCaption`) — never as a second copy of a
// string. §9's "nothing else": no CTA, no chip, no status line.
import '../styles/global.css'
import ShaderCanvas from '../components/ShaderCanvas.astro'
import { heroCaption, heroCopy } from '../lib/hero-copy.ts'
import { MARK } from '../lib/mark.ts'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG card — TypeShade</title>
    {/* `font-display: optional` will serve the metric-matched fallback unless the face is
        there before first paint. The card is measured to the pixel, so the capture warms the
        cache with a reload and then ASSERTS the face — these preloads are what make that
        second load a cache hit rather than a race. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/geist-mono-latin-wght-normal.woff2"
      crossorigin
    />
  </head>
  <body>
    <div class="og-card" data-og-card>
      {/* 0: the live specimen, full bleed. `bleed` emits the host and the payload and nothing
          else, so the canvas is an absolutely-positioned layer of the card. */}
      <ShaderCanvas example="metaballs" bleed class="og-canvas" caption={heroCaption} />

      {/* 1–3: SCRIM.HUE, SCRIM.KEY and SCRIM.EDGE. No SCRIM.BASE — the card has no rail
          beneath it to weld to, and the base layer exists to make that seam (§4, §9). Every
          stop still recomputes from §2's formula against the three overridden tokens below:
          p0 = 680 (56.7 %), p1 = 768, p2 = 880. */}
      <div class="scrim-hue" aria-hidden="true"></div>
      <div class="scrim-key" aria-hidden="true"></div>
      <div class="scrim-edge" aria-hidden="true"></div>

      <div class="og-wordmark">
        <svg viewBox={MARK.viewBox} aria-hidden="true" focusable="false">
          <path
            d={MARK.d}
            fill="none"
            stroke="currentColor"
            stroke-width={MARK.strokeWidth}
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        TypeShade
      </div>

      <h1 class="og-h1 text-h1 font-semibold tracking-[-0.03em]">
        {heroCopy.h1.map((line) => <span class="block">{line}</span>)}
      </h1>
      <p class="og-sub text-lead tracking-[-0.006em] text-text-2">
        {heroCopy.sub.map((line) => <span class="block">{line}</span>)}
      </p>

      <div class="og-rule" aria-hidden="true"></div>
      <p class="og-domain micro-code">typeshade.dev</p>
    </div>
  </body>
</html>

<style is:global>
  /* §9's whole override block: THREE composition tokens and nothing else, so the scrim keeps
     recomputing p0/p1/p2 from §2's formula rather than from numbers typed twice.
     --pad-x stays DERIVED: (1200 - 1008) / 2 = 96. `--text-h1-og` is a declared ladder step,
     not a one-off size. */
  :root {
    --content: 1008px;
    --hero-col: 560px;
    --text-h1: var(--text-h1-og);
  }

  /* The card is exactly the frame that is photographed. `overflow: hidden` on the document is
     what keeps 100vw equal to 1200 with no scrollbar, which is what keeps --pad-x at 96. */
  html,
  body {
    block-size: 630px;
    overflow: hidden;
  }
  .og-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    inline-size: 1200px;
    block-size: 630px;
    background: var(--color-ground);
  }
  .og-canvas {
    position: absolute;
    inset: 0;
    z-index: var(--z-canvas);
  }
  /* Every element below is placed at its §9 y, measured from the card's top edge, and at
     --pad-x from its left. z-hero is the page's own content layer, above all three scrims. */
  .og-wordmark,
  .og-h1,
  .og-sub,
  .og-rule,
  .og-domain {
    position: absolute;
    inset-inline-start: var(--pad-x);
    z-index: var(--z-hero);
    margin: 0;
  }
  .og-wordmark {
    inset-block-start: 64px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-1);
    font-size: var(--text-lead-sm);
    font-weight: 600;
    line-height: 1;
  }
  /* `stroke: currentColor` — the mark takes the wordmark's own text tier, exactly as the nav's
     does, so the card cannot show a wordmark the page never shows. */
  .og-wordmark svg {
    inline-size: 22px;
    block-size: 22px;
  }
  .og-h1 {
    inset-block-start: 232px;
  }
  .og-sub {
    inset-block-start: 398px;
  }
  .og-rule {
    inset-block-start: 500px;
    inline-size: var(--hero-col);
    block-size: 1px;
    background: var(--color-line-1);
  }
  .og-domain {
    inset-block-start: 516px;
  }
</style>
