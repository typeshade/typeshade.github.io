---
import Playground from '../../components/Playground.astro'
import Base from '../../layouts/Base.astro'
import type { Locale } from '../../i18n/index.ts'

const locale = 'ko' as Locale
---

<Base locale={locale} path="/playground/" searchable searchTitle="Playground">
  <main class="playground-page">
    <header class="playground-intro">
      <p class="eyebrow">TypeShade</p>
      <h1>Playground</h1>
      <p>TypeShade TypeScript 파일을 작성하고 브라우저에서 컴파일한 뒤 생성된 WGSL과 진단 결과를 확인하세요.</p>
    </header>
    <Playground locale={locale} />
  </main>
</Base>

<style>
  .playground-page { width: min(1180px, calc(100vw - 40px)); margin: 0 auto; padding: 56px 0 80px; }
  .playground-intro { max-width: 760px; margin-bottom: 28px; }
  .eyebrow { margin: 0 0 8px; color: var(--color-accent); font: 500 .8125rem/1.4 var(--font-mono); letter-spacing: .08em; }
  h1 { margin: 0 0 12px; font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; }
  .playground-intro p:not(.eyebrow) { margin: 0; color: var(--color-text-2); }
  @media (min-width: 48rem) { .playground-page { width: min(1180px, calc(100vw - 64px)); padding-top: 72px; } }
</style>
