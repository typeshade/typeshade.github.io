---
// The front page. Every listing and every number is read at build time from the compiler
// vendored at vendor/shader-dsl. The longer material lives on /motivation, /checks and
// /examples.
import { Code } from 'astro-expressive-code/components'
import Base from '../layouts/Base.astro'
import CodeFrame from '../components/CodeFrame.astro'
import InstallCommand from '../components/InstallCommand.astro'
import ShaderCanvas from '../components/ShaderCanvas.astro'
import type { CanvasText } from '../components/ShaderCanvas.astro'
import { exampleFile, facts, hero } from '../lib/examples.ts'
import { links } from '../lib/links.ts'

const glslTarget = facts.glslTarget

const metaballs: CanvasText = {
  neutral: `Metaballs, from examples/${exampleFile('metaballs')}. The still is captured at build time.`,
  webgpu: 'Metaballs. The WGSL emit is drawing this frame on WebGPU.',
  webgl2: `Metaballs. The ${glslTarget} emit is drawing this frame on WebGL2.`,
  none: 'Metaballs. Rendered at build time; this browser has no WebGPU or WebGL2.',
  reduced: `Metaballs, compiled to WGSL and to ${glslTarget}. One frame is drawn here, since this system asks for reduced motion.`,
}
---

<Base>
  <article class="wrap doc">
    <h1>TypeShade</h1>
    <p>
      TypeShade is a TypeScript library for writing shaders. One typed module emits WGSL for WebGPU and{' '}
      {glslTarget} for WebGL2, and the same module runs on the CPU in double precision, so the compiler's
      output can be checked against it.
    </p>
    <p>
      {facts.bothTargets} of the {facts.examples} examples in the repository emit both targets from one
      source. The library has {facts.runtimeDeps} runtime dependencies, {facts.testFiles} test files and
      an {facts.license} licence. Version {facts.nextVersion} is not on npm yet; the repository is the
      package, used as a git submodule.
    </p>

    <ShaderCanvas example="metaballs" aspect="2/1" eager caption={metaballs} />

    <section>
      <h2>Quick start</h2>
      <InstallCommand />
      <p>
        The package ships TypeScript source, so your build needs a toolchain that compiles it. This is the
        fragment stage of the gradient example, {hero.authoredLines} lines as authored in{' '}
        <code>{hero.file}</code>:
      </p>
      <CodeFrame label={`Authored fragment, ${hero.file}`}>
        <Code code={hero.authored} lang="ts" title={hero.file} />
      </CodeFrame>
      <p>It emits this WGSL entry point:</p>
      <CodeFrame label="The emitted WGSL fragment entry point">
        <Code code={hero.wgsl} lang="wgsl" />
      </CodeFrame>
      <p>
        The {glslTarget} stage for the same function, and the uniform layout{' '}
        <a href={links.reflectApi.href}>reflect()</a> recovers for it, are on the{' '}
        <a href={links.examples.href}>examples page</a>. The{' '}
        <a href={links.guide.href}>authoring guide</a> covers the rest of the surface.
      </p>
    </section>

    <section>
      <h2>What it does</h2>
      <ul>
        <li>
          Typed functions, entry points, control flow, and declarators for uniform blocks, storage buffers,
          IO structs, textures and samplers.
        </li>
        <li>A misspelt uniform field or a wrong-typed return is a TypeScript error in the editor.</li>
        <li>
          <code>reflect()</code>: bind groups, {facts.layoutStandards.join(' and ')} layouts and entry
          signatures, read from the same intermediate representation.
        </li>
        <li>Emulated double precision, written with the same syntax as f32.</li>
        <li>
          An optimizer over the IR: common subexpression and dead code elimination, loop-invariant hoisting,
          constant folding.
        </li>
        <li>A CPU oracle: the module compiled to an f64 JavaScript function, used by the test suite.</li>
        <li>
          Coded diagnostics, <code>variantFamily</code> for N specialised emits of one module, and{' '}
          <code>semanticDiff</code> for reviewing an emit change.
        </li>
      </ul>
      <p>
        TypeShade has no renderer. It returns strings and reflection metadata; pipelines, bindings and draw
        calls stay with the host.
      </p>
    </section>

    <section>
      <h2>Read more</h2>
      <ul>
        <li>
          <a href={links.motivation.href}>{links.motivation.label}</a>: why one source for two shader
          languages.
        </li>
        <li>
          <a href={links.checks.href}>{links.checks.label}</a>: the CPU oracle, the compile gate on Tint
          and WebGL2, and the golden files.
        </li>
        <li>
          <a href={links.examples.href}>{links.examples.label}</a>: the {facts.examples} examples, the
          GLSL emit, and the emulated-double demo.
        </li>
        <li>
          <a href={links.guide.href}>{links.guide.label}</a> and the{' '}
          <a href={links.docs.href}>{links.docs.label}</a>, on GitHub.
        </li>
      </ul>
    </section>

    <section>
      <h2>Status</h2>
      <p>
        Pre-release. The repository is at version {facts.mirrorVersion}; {facts.nextVersion} is the release
        the npm name <a href={links.npm.href}>{links.npm.label}</a> is reserved for, and the manifest and
        the imports are renamed at that tag. Issues are welcome; pull requests cannot be merged yet, because
        changes land upstream and this tree is fast-forwarded from there.{' '}
        <a href={links.releases.href}>{links.releases.label}</a> to hear about {facts.nextVersion}.
      </p>
    </section>
  </article>
</Base>
