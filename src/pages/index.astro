---
import Base from '../layouts/Base.astro'
import { Code } from 'astro-expressive-code/components'
import { hero, facts } from '../lib/examples.ts'

const mirror = 'https://github.com/typeshade/typeshade'
const docs = 'https://x-gis.github.io/X-GIS/shader-dsl/'
const guide = `${mirror}/blob/main/AUTHORING.md`

const pillars = [
  { title: 'One source', body: 'Author a shader once in TypeScript. The compiler emits WGSL for WebGPU and GLSL ES 3.00 for WebGL2.' },
  { title: 'Typed', body: 'Types are checked while you write. A wrong field or return is an editor error, not a runtime shader error.' },
  { title: 'Verified', body: 'The same shader runs on a CPU oracle, and both outputs are compiled by real shader compilers in CI.' },
]

const compare = [
  { name: 'TypeShade', host: 'Any engine', targets: 'WGSL + GLSL ES 3.00', note: 'CPU oracle, compile gates, byte-stable output' },
  { name: 'three.js TSL', host: 'three.js', targets: 'WGSL + GLSL', note: 'Part of the three.js renderer' },
  { name: 'TypeGPU', host: 'WebGPU first', targets: 'WGSL, partial GLSL', note: 'WebGL2 backend is experimental' },
]
---

<Base>
  <header class="border-b border-line">
    <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5">
      <a href="/" class="flex items-center gap-2 text-[15px] font-semibold tracking-tight">
        <span class="inline-block h-4 w-4 rounded-[5px] grad-line"></span>
        TypeShade
      </a>
      <div class="flex items-center gap-5 text-[14px] text-fg-2">
        <a href={docs} class="hover:text-fg">Docs</a>
        <a href={guide} class="hover:text-fg">Guide</a>
        <a href={mirror} class="hover:text-fg">GitHub</a>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-5xl px-5">
    <!-- Hero: no code -->
    <section class="pt-20 pb-14 text-center sm:pt-28">
      <p class="mb-4 inline-block rounded-full border border-line-2 px-3 py-1 font-mono text-[11px] tracking-[0.12em] text-fg-3">pre-release</p>
      <h1 class="mx-auto max-w-3xl text-balance text-[40px] font-semibold leading-[1.05] tracking-[-0.025em] sm:text-[60px]">
        Typed shaders in <span class="grad-text">TypeScript</span>.
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-balance text-[17px] leading-[1.6] text-fg-2">
        One source compiles to WGSL for WebGPU and GLSL ES&nbsp;3.00 for WebGL2.
        A CPU oracle proves the two agree.
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <a href={guide} class="inline-flex h-11 items-center rounded-full bg-fg px-6 text-[14px] font-medium text-bg hover:bg-fg-2">Get started</a>
        <a href={mirror} class="inline-flex h-11 items-center rounded-full border border-line-2 px-6 text-[14px] hover:border-fg-3">GitHub</a>
      </div>
    </section>

    <!-- One small example: authored → two outputs → what it draws -->
    <section class="pb-20">
      <div class="grid items-start gap-4 lg:grid-cols-[1.25fr_1fr]">
        <div class="min-w-0">
          <p class="mb-2 font-mono text-[11px] tracking-[0.12em] text-fg-3">you write</p>
          <Code code={hero.authored} lang="ts" wrap />
        </div>
        <div class="grid grid-cols-1 min-w-0 gap-4">
          <div>
            <p class="mb-2 font-mono text-[11px] tracking-[0.12em] text-fg-3">WebGPU gets</p>
            <Code code={hero.wgsl} lang="wgsl" wrap />
          </div>
          <div>
            <p class="mb-2 font-mono text-[11px] tracking-[0.12em] text-fg-3">WebGL2 gets</p>
            <Code code={hero.glsl} lang="glsl" wrap />
          </div>
        </div>
        <div class="min-w-0 lg:col-span-2">
          <p class="mb-2 font-mono text-[11px] tracking-[0.12em] text-fg-3">both draw</p>
          <div class="h-16 rounded-[10px] border border-line" style={`background: linear-gradient(to top, ${hero.bottom}, ${hero.top})`}></div>
        </div>
      </div>
      <p class="mt-3 text-center text-[12.5px] text-fg-3">
        Emitted at build time by the compiler pinned at <a href={`${mirror}/commit/${facts.pinnedCommit}`} class="font-mono text-fg-2 hover:text-fg">{facts.pinnedCommit}</a>.
      </p>
    </section>

    <!-- Three pillars -->
    <section class="border-t border-line py-16">
      <div class="grid gap-8 sm:grid-cols-3">
        {pillars.map((p) => (
          <div>
            <h2 class="text-[17px] font-semibold">{p.title}</h2>
            <p class="mt-2 text-[14.5px] leading-[1.6] text-fg-2">{p.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Numbers -->
    <section class="border-t border-line py-12">
      <dl class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
        <div><dd class="text-[30px] font-semibold">{facts.examples}</dd><dt class="text-[13px] text-fg-3">examples, each emitting both targets</dt></div>
        <div><dd class="text-[30px] font-semibold">{facts.fp64Examples}</dd><dt class="text-[13px] text-fg-3">emulated fp64 examples</dt></div>
        <div><dd class="text-[30px] font-semibold">{facts.testFiles}</dd><dt class="text-[13px] text-fg-3">test files</dt></div>
        <div><dd class="text-[30px] font-semibold">0</dd><dt class="text-[13px] text-fg-3">runtime dependencies</dt></div>
      </dl>
    </section>

    <!-- Compared -->
    <section class="border-t border-line py-16">
      <h2 class="text-[22px] font-semibold tracking-[-0.02em]">Where it fits</h2>
      <div class="mt-5 overflow-x-auto rounded-[12px] border border-line">
        <table class="w-full min-w-[560px] text-left text-[14px]">
          <thead class="bg-bg-2 font-mono text-[11px] tracking-[0.12em] text-fg-3">
            <tr><th class="px-4 py-3 font-normal">tool</th><th class="px-4 py-3 font-normal">host</th><th class="px-4 py-3 font-normal">targets</th><th class="px-4 py-3 font-normal">note</th></tr>
          </thead>
          <tbody>
            {compare.map((r) => (
              <tr class="border-t border-line">
                <td class="px-4 py-3 font-medium">{r.name}</td>
                <td class="px-4 py-3 text-fg-2">{r.host}</td>
                <td class="px-4 py-3 text-fg-2">{r.targets}</td>
                <td class="px-4 py-3 text-fg-2">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Status -->
    <section class="border-t border-line py-16">
      <h2 class="text-[22px] font-semibold tracking-[-0.02em]">Use it today</h2>
      <p class="mt-3 max-w-2xl text-[15px] leading-[1.6] text-fg-2">
        The compiler is in production inside the <a href="https://github.com/X-GIS/X-GIS" class="text-fg underline decoration-line-2 underline-offset-4">X-GIS</a> globe engine
        as <span class="font-mono text-[13.5px] text-fg">{facts.packageName}</span>. The <span class="font-mono text-[13.5px] text-fg">typeshade</span>
        npm package is reserved until the 0.1.0 release. Until then, add the read-only mirror as a submodule.
      </p>
      <div class="mt-5 max-w-2xl">
        <Code lang="bash" code={`git submodule add https://github.com/typeshade/typeshade vendor/shader-dsl`} wrap />
      </div>
      <div class="mt-5 flex flex-wrap gap-3 text-[14px]">
        <a href={guide} class="rounded-full border border-line-2 px-4 py-1.5 hover:border-fg-3">Authoring guide</a>
        <a href={docs} class="rounded-full border border-line-2 px-4 py-1.5 hover:border-fg-3">Docs</a>
        <a href="https://github.com/X-GIS/X-GIS/tree/main/shader-dsl" class="rounded-full border border-line-2 px-4 py-1.5 hover:border-fg-3">Source</a>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-5 py-8 text-[13px] text-fg-3">
      <p>TypeShade · MIT</p>
      <div class="flex gap-5">
        <a href={mirror} class="hover:text-fg">GitHub</a>
        <a href="https://www.npmjs.com/package/typeshade" class="hover:text-fg">npm</a>
        <a href="/llms.txt" class="hover:text-fg">llms.txt</a>
      </div>
    </div>
  </footer>
</Base>
