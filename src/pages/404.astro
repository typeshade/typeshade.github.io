---
// /404.html — copy 07-copy-deck.md §7, geometry design §5.
//
// It mounts no canvas and sets its `h1` at `--text-h2-lg`, so it cannot be mistaken for the
// hero, and it renders the primary CTA from the SAME record the hero renders from — which is
// what lets R-12 assert equality instead of comparing two strings that were typed twice.
import Base from '../layouts/Base.astro'
import { links } from '../lib/links.ts'
---

<Base title="Not found — TypeShade">
  <section class="mx-auto w-[var(--content)] py-28 lg:py-40">
    <h1 class="text-h2-lg max-w-[16em] font-semibold tracking-[-0.025em] text-balance">
      That page is not here. The compiler is.
    </h1>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <a class="btn-primary" href={links.guide.href}>
        {links.guide.label}<span aria-hidden="true">→</span>
      </a>
      <a class="link link-tertiary" href={links.home.href}>{links.home.label}</a>
    </div>
  </section>
</Base>
