---
import Base from '../layouts/Base.astro'
import { links } from '../lib/links.ts'
---

<Base title="Page not found, TypeShade">
  <section class="wrap section">
    <h1>There is nothing at this address.</h1>
    <p class="lead mt-5">The page may have moved. The front page and the guide are still here.</p>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a class="btn" href={links.home.href}>{links.home.label}</a>
      <a class="btn-ghost" href={links.guide.href}>{links.guide.label}</a>
    </div>
  </section>
</Base>
