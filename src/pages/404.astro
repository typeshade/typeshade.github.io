---
import Base from '../layouts/Base.astro'
import { links } from '../lib/links.ts'
---

<Base title="Page not found, TypeShade">
  <article class="wrap doc">
    <h1>There is nothing at this address.</h1>
    <p>The page may have moved. The front page and the authoring guide are still here.</p>
    <p>
      <a href={links.home.href}>{links.home.label}</a>, or read the{' '}
      <a href={links.guide.href}>authoring guide</a>.
    </p>
  </article>
</Base>
